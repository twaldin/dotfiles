# Window management only. skhd owns the exact chords below. Raycast keeps
# non-conflicting Hyper application shortcuts.

# Hyper focuses an adjacent window. H/J/K/L and the arrow keys are equivalent.
cmd + ctrl + alt + shift - h : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --focus west
cmd + ctrl + alt + shift - j : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --focus south
cmd + ctrl + alt + shift - k : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --focus north
cmd + ctrl + alt + shift - l : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --focus east
cmd + ctrl + alt + shift - left : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --focus west
cmd + ctrl + alt + shift - down : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --focus south
cmd + ctrl + alt + shift - up : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --focus north
cmd + ctrl + alt + shift - right : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --focus east
alt - tab : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --focus recent

# Option-Shift moves the focused BSP node. H/J/K/L and arrows are equivalent.
shift + alt - h : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --warp west
shift + alt - j : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --warp south
shift + alt - k : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --warp north
shift + alt - l : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --warp east
shift + alt - left : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --warp west
shift + alt - down : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --warp south
shift + alt - up : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --warp north
shift + alt - right : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --warp east

# Layout controls.
alt - return : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --toggle zoom-fullscreen
alt - 0x32 : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --toggle float
alt - 0 : /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m space --balance
alt - 0x1B : child=$(/Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m query --windows --window | /usr/bin/jq -r '."split-child"'); if [ "$child" = first_child ]; then delta=-0.05; elif [ "$child" = second_child ]; then delta=0.05; else exit 1; fi; /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --ratio rel:$delta
alt - 0x18 : child=$(/Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m query --windows --window | /usr/bin/jq -r '."split-child"'); if [ "$child" = first_child ]; then delta=0.05; elif [ "$child" = second_child ]; then delta=-0.05; else exit 1; fi; /Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai -m window --ratio rel:$delta


