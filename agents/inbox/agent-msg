#!/usr/bin/env python3
"""Message an omp agent, in a herdr pane or an easl tile, without typing into its terminal.

    agent-msg <agent>[@<host or board>] <text...> [--from NAME] [--message ID]

Agents with the omp-inbox extension use `write agent://<name>[@<host>]`, which runs this.
Shell scripts, and panes started before the extension, call it directly.

An omp agent in an easl tile (`name` or `name@board`, as `easl agent.list` shows its address) gets
the text through `easl tell`, out of band. Called from a tile without --from, the message names
that tile, so the receiver can reply.

Otherwise the text goes to the herdr agent's omp inbox and arrives as an agent-attributed message
at its next step boundary; a busy agent's long `wait` is interrupted so it sees it. It never enters
a half-typed draft or answers an open question. `@<host>` delivers on that host over ssh.

A pane started before the extension was installed has no inbox yet. Then this falls back
to `herdr agent prompt`, which does type into the pane, so it refuses (exit 75) while the
pane is blocked on a question or focused by Tim. Retry later, or restart that pane.
"""
import argparse
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path.home() / '.local/state/omp-inbox'
EASL_APP = Path('/Applications/easl.app/Contents/Resources/bin/easl')


def easl_agents():
    """(easl CLI, its agent.list) on a host with easl; (None, []) without it or when it is down."""
    cli = shutil.which('easl') or (str(EASL_APP) if EASL_APP.is_file() else None)
    if not cli:
        return None, []
    try:
        r = subprocess.run([cli, 'agent.list'], capture_output=True, text=True, timeout=10)
        return cli, json.loads(r.stdout)['agents'] if r.returncode == 0 else []
    except (OSError, subprocess.TimeoutExpired, ValueError, KeyError):
        return cli, []


def easl_address(agents, name, board):
    """The address of the easl tile whose omp takes out-of-band messages, or None."""
    # Only omp tiles with an integration (protocol >= 1): `easl tell` would type into anything else.
    found = sorted({a['address'] for a in agents
                    if a.get('open') and (a.get('protocol') or 0) >= 1 and a.get('address')
                    and (a['address'] == f'{name}@{board}' if board else a.get('name') == name)})
    if len(found) > 1:
        sys.exit(f'agent-msg: {name!r} is on several easl boards ({", ".join(found)}); say <name>@<board>')
    return found[0] if found else None


def tell(cli, address, text, origin, message=None):
    command = [cli, 'tell', address, text]
    if origin:
        command += ['--from', origin]
    if message:
        command += ['--message', message]
    r = subprocess.run(command, capture_output=True, text=True)
    if r.returncode:
        sys.exit(f'agent-msg: easl tell {address} failed: {(r.stderr or r.stdout).strip()}')
    try:
        delivery = json.loads(r.stdout).get('delivery')
    except ValueError:
        delivery = None
    print(f'agent-msg: typed into {address}' if delivery == 'typed' else f'agent-msg: queued for {address}')
    sys.exit(0)


def tile_address(agents):
    """This tile's easl address (`name@board`) when called from an easl tile, else None."""
    tile = os.environ.get('EASL_TILE_ID')
    return next((a.get('address') for a in agents if tile and a.get('tile') == tile), None)


def herdr():
    found = shutil.which('herdr') or str(Path.home() / '.local/bin/herdr')
    if not Path(found).is_file():
        sys.exit('agent-msg: herdr is not installed on this host')
    return found


def agent(name):
    r = subprocess.run([herdr(), 'agent', 'get', name], capture_output=True, text=True)
    if r.returncode:
        listed = subprocess.run([herdr(), 'agent', 'list'], capture_output=True, text=True)
        try:
            names = sorted(a['name'] for a in json.loads(listed.stdout)['result']['agents'] if a.get('name'))
        except (ValueError, KeyError):
            names = []
        sys.exit(f'agent-msg: no herdr agent named {name!r} on this host. Live agents: {", ".join(names) or "none"}')
    return json.loads(r.stdout)['result']['agent']


def live_inbox(info):
    session = info.get('agent_session') or {}
    value = session.get('value')
    if info.get('agent') != 'omp' or not value:
        return None
    key = Path(value).name.removesuffix('.jsonl') if session.get('kind') == 'path' else value
    inbox = ROOT / key
    try:
        os.kill(int((inbox / '.pid').read_text()), 0)
    except (OSError, ValueError):
        return None
    return inbox


def sender():
    host = socket.gethostname().split('.')[0]
    # A pane moved with `herdr pane move` keeps its old HERDR_PANE_ID in the environment;
    # herdr resolves that id to the current pane only for this caller.
    pane = subprocess.run([herdr(), 'pane', 'get', os.environ.get('HERDR_PANE_ID', '')],
                          capture_output=True, text=True)
    agents = subprocess.run([herdr(), 'agent', 'list'], capture_output=True, text=True)
    try:
        current = json.loads(pane.stdout)['result']['pane']['pane_id']
        for a in json.loads(agents.stdout)['result']['agents']:
            if a.get('pane_id') == current and a.get('name'):
                return f"{a['name']}@{host}"
    except (ValueError, KeyError):
        pass
    return f'shell@{host}'


def remote(host, name, text, origin, message=None):
    # Tailscale SSH on the Macs drops the remote exit status, so judge by the output.
    parts = [name, text, '--from', origin]
    if message:
        parts += ['--message', message]
    command = ' '.join(shlex.quote(part) for part in parts)
    r = subprocess.run(['ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=8', host,
                        f'"$HOME"/.local/bin/agent-msg {command}'], capture_output=True, text=True)
    out = (r.stdout + r.stderr).strip()
    print(out or f'agent-msg: no response from {host}')
    if 'not typing into it' in out:
        sys.exit(75)
    sys.exit(0 if re.search(r'agent-msg: (queued for|typed into)', out) else 1)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('agent')
    parser.add_argument('text', nargs='+')
    parser.add_argument('--from', dest='sender')
    # Reuse the id of an easl prompt that timed out but may still have queued.
    parser.add_argument('--message', help='easl message id shared by every attempt at this message')
    # Ignored. omp-inbox loaded in tiles before 2026-10-07 passes it; drop it once those tiles restart.
    parser.add_argument('--herdr-only', action='store_true', help=argparse.SUPPRESS)
    args = parser.parse_args()
    text = ' '.join(args.text).strip()
    if not text:
        sys.exit('agent-msg: empty message')
    name, _, host = args.agent.partition('@')
    local = socket.gethostname().split('.')[0]
    cli, agents = easl_agents()
    # `name@<this host>` is how herdr agents address everyone here, tiles included.
    address = easl_address(agents, name, '' if host == local else host)
    if address:
        # From a tile, easl names the calling tile itself, with a reply address.
        from_tile = args.sender is None and tile_address(agents)
        tell(cli, address, text, None if from_tile else args.sender or sender(), args.message)
    origin = args.sender or tile_address(agents) or sender()
    if host and host != local:
        # A tile's `name@board` means nothing on another machine: name this host, where a reply lands.
        remote(host, name, text, origin if args.sender else f"{origin.partition('@')[0]}@{local}", args.message)
    info = agent(name)
    inbox = live_inbox(info)
    if inbox:
        payload = {'from': origin, 'text': text, 'sent_at': time.time()}
        fd, temporary = tempfile.mkstemp(prefix='.', suffix='.tmp', dir=inbox)
        with os.fdopen(fd, 'w') as out:
            json.dump(payload, out)
        os.replace(temporary, inbox / f'{time.time_ns()}-{os.getpid()}.json')
        print(f'agent-msg: queued for {name}')
        return
    if info.get('agent_status') == 'blocked' or info.get('focused'):
        why = 'blocked on a question' if info.get('agent_status') == 'blocked' else 'focused by Tim'
        print(f'agent-msg: {name} has no inbox yet and is {why}; not typing into it. '
              'Retry later, or restart that pane to load omp-inbox.', file=sys.stderr)
        sys.exit(75)
    # This pane has no omp-inbox, so `write agent://` can't reach other sessions from it.
    typed = f"[message from {origin}; reply by running: agent-msg {origin} '<text>'] {text}"
    result = subprocess.run([herdr(), 'agent', 'prompt', name, typed], stdout=subprocess.DEVNULL)
    if result.returncode == 0:
        print(f'agent-msg: typed into {name} (no inbox yet)')
    sys.exit(result.returncode)


if __name__ == '__main__':
    main()
