#!/bin/bash
# Exit 0 when this Mac has headroom for heavy work (builds, captures, native clients), 1 otherwise.
# Gate (Tim, 2026-09-25): CPU idle > 30%, memory_pressure free > 25%, compressor occupancy
# < 30% of physical RAM unless free memory is at least 50% (added 2026-09-26, exception
# 2026-09-28), and no memory-driven paging (revised 2026-09-26): swap-ins + swap-outs
# < 100/s, and pageins < 500/s unless free memory is at least 50%.
# Pageins alone count file reads too: on twaldin-home the old "pageins < 500/s" rule
# blocked a build at 1,230 pageins/s with 78% free and 0 swap-ins/page-outs, and 507 of
# 512 page-in events came from XprotectService scanning new binaries. File pages are
# only re-read under pressure once memory is short, so pageins count only below 50% free.
# The compressor check exists because `memory_pressure` free% does NOT account for
# compressed pages: fseventsd once held 14 GB (phys_footprint, almost all compressed)
# while free% still read 53% and this gate passed, on a machine that was visibly
# struggling. Compressor occupancy was 21 GB of 64 GB (33%) at that moment. RSS is
# useless here too -- that same fseventsd showed 15 MB resident. Use
# `sudo footprint -p <pid>` to attribute a hoarder once this check trips.
# Exception (Tim, 2026-09-28): at 50%+ free the compressor does not block. With 14 agents on
# twaldin-home it sat at 30-32% for over half an hour -- idle pages spread across every
# session, 52% free, 0 swap/s -- and held every gated launch. This reopens the fseventsd
# case above for the gate; hoarders are caught instead by machine-watch (fseventsd > 1 GB,
# an agent > 3 GB, compressor > 30% twice) and reclaimed by the machine shepherd.
# Load average is NOT used: with hundreds of processes it tracks process count and thread
# count, not saturation. Measured on twaldin-home: load1 sat at 20-40 while 40-55% of CPU
# was idle; on twaldin-work it read 4.58 while free memory was the real binding constraint.
# `machine-ok --wait` blocks until the gate passes, re-checking every 30 s.
# `machine-ok --memory` drops the CPU criterion. It is the admission check for jobs whose risk
# is memory (runner-test's pool): a running typecheck keeps CPU idle under 30%, so with the full
# gate every other runner would wait even with memory to spare.
# `machine-ok --gpu` adds a quiet-GPU criterion for runs whose results depend on the GPU and the
# compositor (native lab clients under measurement): GPU busy <= 20% and WindowServer CPU <= 40%
# over the sample, on top of the other checks. Added 2026-09-29 for bench-judge, whose client
# stalls in glfwSwapBuffers varied 10x between blocks while CPU and memory looked fine. On
# twaldin-home the desktop alone measured ~12% GPU (WindowServer 10%, ghostty 2%); one
# animating browser page added 20%. GPU busy is the sum of per-process GPU time from the GPU
# driver's own client records (ioreg AGXDeviceUserClient), which also names the top consumer;
# powermetrics reports 0 per-process GPU time on these Macs. WindowServer CPU comes from `ps`
# CPU time, via `sudo -n` because agent panes cannot see other users' processes; when neither
# works it prints windowserver=n/a and only the GPU criterion applies. Not in the default gate:
# builds and tests do not need the GPU, and would otherwise wait whenever something animates.
# Originally written by Firstmate for ~/work-agent-system/bin; shared here for all agents.
set -uo pipefail

wait=0 memory_only=0 gpu=0
for arg in "$@"; do
    case $arg in
        --wait) wait=1 ;;
        --memory) memory_only=1 ;;
        --gpu) gpu=1 ;;
        -h|--help)
            cat <<'EOF'
usage: machine-ok [--wait] [--memory] [--gpu]

Exit 0 when this Mac has headroom for heavy work (builds, tests, captures, native
clients), 1 otherwise. Use it instead of the load average, which tracks process and
thread count, not saturation, and is wrong in both directions.

One sample of about 2 s must pass every check:
  CPU idle > 30%                         (skipped with --memory)
  memory_pressure free > 25%
  swap-ins + swap-outs < 100/s
  below 50% free only: compressor < 30% of RAM and page-ins < 500/s
                       (above 50% free, page-ins are file reads and the compressor is idle pages)
  with --gpu: GPU busy <= 20% and WindowServer CPU <= 40%

  --wait    re-check every 30 s until the gate passes. Prefer it to judging one sample:
            idle swings widely between reads, so a single closed gate can be noise.
  --memory  admission for memory-heavy jobs (tests, typechecks) while other jobs keep the
            CPU busy. It samples before your job grows, so cap the job's own workers too.
  --gpu     for runs whose results depend on the GPU and compositor.

Test the exit code directly: in `machine-ok | tee log`, $? is tee's status and the gate
always appears to pass. A process hoarding compressed memory is the machine shepherd's to
find; report it there.
EOF
            exit 0 ;;
        *) echo "usage: machine-ok [--wait] [--memory] [--gpu]" >&2; exit 2 ;;
    esac
done

now() { perl -MTime::HiRes=time -e 'printf "%.3f\n", time'; }
# One line per GPU client process: pid, name, accumulated GPU time in ns.
gpu_times() {
    ioreg -l -w0 -r -c AGXDeviceUserClient | awk '
        function flush() { if (who != "") t[who] += ns; ns = 0; who = "" }
        /\+-o AGXDeviceUserClient/ { flush() }
        /"accumulatedGPUTime"=/ { s = $0; while (match(s, /"accumulatedGPUTime"=[0-9]+/)) { ns += substr(s, RSTART + 21, RLENGTH - 21); s = substr(s, RSTART + RLENGTH) } }
        /"IOUserClientCreator" = "pid / { match($0, /pid [0-9]+, [^"]*/); c = substr($0, RSTART + 4, RLENGTH - 4); i = index(c, ", "); who = substr(c, 1, i - 1) "\t" substr(c, i + 2) }
        END { flush(); for (k in t) printf "%s\t%.0f\n", k, t[k] }'
}
# CPU seconds used so far by a pid, or nothing when it is not visible.
cpu_seconds() {
    { sudo -n ps -o time= -p "$1" 2>/dev/null || ps -o time= -p "$1"; } | awk -F: 'NF { s = 0; for (i = 1; i <= NF; i++) s = s * 60 + $i; printf "%.2f\n", s }'
}

check() {
    local idle= free v1 v2 pageins swap comp_pages pagesize memsize comp_pct
    local ws= g1= g2= w1= w2= t1= t2= gpu_line= gpu_pct=0 ws_pct=-1 gpu_status=
    # Find the "id" column by name: iostat prints three columns per disk before the cpu
    # block, so a fixed field number breaks when a second disk is attached (twaldin-work
    # has disk4, and `$6` there was disk4 MB/s = 0.00, blocking every caller).
    [ "$memory_only" = 1 ] ||
        idle=$(iostat -c 2 | awk 'NR == 2 { for (i = 1; i <= NF; i++) if ($i == "id") c = i } NR > 2 && c { v = $c } END { print v }')
    free=$(memory_pressure 2>/dev/null | awk -F': ' '/System-wide memory free percentage/ {gsub("%","",$2); print $2}')
    if [ "$gpu" = 1 ]; then
        ws=$({ sudo -n pgrep -x WindowServer 2>/dev/null || pgrep -x WindowServer; } | head -1)
        t1=$(now); g1=$(gpu_times); w1=$(cpu_seconds "$ws")
    fi
    v1=$(vm_stat)
    sleep 1
    v2=$(vm_stat)
    if [ "$gpu" = 1 ]; then
        t2=$(now); g2=$(gpu_times); w2=$(cpu_seconds "$ws")
        # busy% = GPU ns / (elapsed s * 1e9) * 100; also the process with the largest share.
        gpu_line=$(awk -F'\t' -v dt="$(awk -v a="$t1" -v b="$t2" 'BEGIN { print b - a }')" '
            NR == FNR { a[$1 FS $2] = $3; next }
            { d = $3 - a[$1 FS $2]; if (d > 0) { sum += d; if (d > best) { best = d; who = $2 } } }
            END { printf "%d\t%s\t%d\n", sum / (dt * 1e7), who, best / (dt * 1e7) }' \
            <(printf '%s\n' "$g1") <(printf '%s\n' "$g2"))
        gpu_pct=${gpu_line%%$'\t'*}
        [ -n "$w1" ] && [ -n "$w2" ] &&
            ws_pct=$(awk -v a="$w1" -v b="$w2" -v t1="$t1" -v t2="$t2" 'BEGIN { printf "%d", (b - a) * 100 / (t2 - t1) }')
        gpu_status=$(printf '%s\n' "$gpu_line" | awk -F'\t' -v w="$ws_pct" '{ printf " gpu=%d%%", $1; if ($3 > 0) printf " (%s %d%%)", $2, $3; if (w < 0) printf " windowserver=n/a"; else printf " windowserver=%d%%", w }')
    fi
    counter() { printf '%s\n' "$1" | awk -v k="$2" '$1 == k":" {gsub("\\.","",$2); print $2}'; }
    pageins=$(( $(counter "$v2" Pageins) - $(counter "$v1" Pageins) ))
    swap=$(( $(counter "$v2" Swapins) + $(counter "$v2" Swapouts) - $(counter "$v1" Swapins) - $(counter "$v1" Swapouts) ))
    comp_pages=$(printf '%s\n' "$v2" | awk '/Pages occupied by compressor/ {gsub("\\.","",$NF); print $NF}')
    pagesize=$(printf '%s\n' "$v2" | awk 'NR==1 {gsub("[^0-9]","",$8); print $8}')
    memsize=$(sysctl -n hw.memsize)
    comp_pct=$(awk -v c="${comp_pages:-0}" -v s="${pagesize:-16384}" -v m="$memsize" \
                 'BEGIN { if (m > 0) printf "%d", (c * s * 100) / m; else print 0 }')
    echo "${idle:+idle=${idle}% }free=${free}% pageins=${pageins}/s swap=${swap}/s compressed=${comp_pct}%${gpu_status}"
    awk -v i="${idle:-100}" -v f="$free" -v p="$pageins" -v s="$swap" -v c="$comp_pct" \
        -v gon="$gpu" -v g="$gpu_pct" -v w="$ws_pct" \
        'BEGIN { exit !(i > 30 && f > 25 && (c < 30 || f >= 50) && s < 100 && (p < 500 || f >= 50) && (!gon || (g <= 20 && w <= 40))) }'
}

# Every path exits inside this block. Bash reads a script as it runs, and a --wait that
# outlived an in-place edit of this file read its next line at a stale byte offset and died
# with a syntax error (exit 2) the moment the gate opened (2026-09-28). A compound command
# is parsed whole before it runs, so nothing past this block is ever read.
if [ "$wait" = 1 ]; then
    until status=$(check); do
        echo "machine busy ($status); waiting 30s" >&2
        sleep 30
    done
    echo "$status"
    exit 0
else
    check
    exit
fi
