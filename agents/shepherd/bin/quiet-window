#!/usr/bin/python3
"""quiet-window: book and enforce quiet windows for measured runs on twaldin-home.

  quiet-window add START END OWNER LABEL [--quiet heavy|full] [--reason TEXT]
                                           START/END in UTC, e.g. 2026-10-01T08:30Z; OWNER = herdr agent
                                           name (preferred: survives pane moves) or pane id, or easl tile name
  quiet-window hold START END OWNER LABEL [--quiet heavy|full] [--reason TEXT]
                                           the same, for a run whose driver refuses any registry row
                                           (its own included): kept in quiet-holds.json, which such
                                           drivers never read, and enforced exactly like a booking
  quiet-window list | remove ID            list shows bookings and holds; remove ends a running one now
                                           (it still gets its summary)
  quiet-window mute ID                     end summary to the shepherd only (owner busy with Tim)
  quiet-window tick                        run every minute by launchd (net.waldin.quiet-window)

Quiet levels (Tim and bench-judge, 2026-10-07). A window is `heavy` unless booked `--quiet full`; the row keeps
`quiet` and `reason`, and a row without `quiet` (written before the levels) is heavy.
  heavy  Tim's rule: pause or queue only heavy processes (builds, dev servers, test runs, renders, encodes,
         benchmarks, game clients, screen captures); reading, coding, reviewing and subagents continue.
  full   FULL QUIET across boards: no heavy processes and no new processes, subagents, lanes or tool-executing
         agents on this Mac; reading and writing text only. For a run the heavy rule cannot protect (a suite's
         sub-second latency bounds). --reason is required and names the process classes the run needs paused
         and the measured reason; it goes into the notices, the STOP NOW prompts and `list` ([FULL QUIET: ...]).

tick: before a window, every other agent that runs work gets the notice in the window's wording: a herdr agent
with an effort brief (~/cos/efforts/<name>/brief.md), and every omp easl tile with an easl protocol (>= 1),
briefed or not (board CoSes spawn worker tiles whose briefs are notes on their board). A heavy window gets one
notice 10 minutes ahead. A full window gets a notice 30 minutes ahead and a reminder 5 minutes ahead (kept
separately, so one booked later than 30 minutes ahead gets its notice at the next tick and still the reminder).
A recipient that refuses (blocked, focused, no inbox yet) is asked again at every tick. During the window,
quiet-check --pane OWNER names processes of other agents at 10%+ CPU; each such agent gets a "stop now" prompt
in the window's wording (at most every 4 minutes). At the end, the owner and the shepherd get a summary. A
herdr agent without a brief (Tim's own ad-hoc sessions) is never messaged; its load still shows in the summary.
With ~/.config/machine-shepherd/easl.json enabled, easl agent tiles take part too: a tile may own a window,
and omp tiles with an easl protocol get the notice, reminder, "stop now" and summary through `easl agent.prompt
--when now`: a working agent is steered mid-turn, at its next step (`--when next-turn` held them until its turn
ended, hours late for a long one; changed 2026-10-07). Any other tile is skipped, never typed into, and a
delivery easl reports as "typed" is a loud failure with no more prompts to that tile in the window. herdr
panes get the same texts through agent-msg (an omp inbox aside at the agent's next step).
In a heavy window an agent's own omp runtime is never an offender: quiet-check tags it "(agent runtime)" below 50%
CPU and flags it above, and quiet-window ignores both, since reading, coding and subagents run inside it; its heavy
children are named. In a full window a hot omp (quiet-check's 50%+) is an offender like any other process.
From 3 minutes before a booking or hold until it ends (bench samples for its ARM check just before the
start), mediaanalysisd above 50% CPU is stopped (SIGSTOP), and it is resumed (SIGCONT) once nothing runs
or starts within 15 minutes; every stop and resume is logged (Tim approved this 2026-10-06:
spotlightknowledged had driven it to ~160% just before a measured run).
Why (2026-10-01): sky-lead's quiet notices reached only its own panes, so canvas's encode and
build cancelled bench-judge's measured sitting 24 of 48 legs in.
Why (2026-10-07): the old hold banned every new lane and subagent, read-only reviewers included, for runs that
only needed builds and test runs paused; and notices to easl tiles waited for the target's turn to end."""
import argparse
import datetime as dt
import json
import os
import re
import signal
import subprocess
import sys

BOOK = os.path.expanduser("~/.config/machine-shepherd/quiet-windows.json")
HOLDS = os.path.expanduser("~/.config/machine-shepherd/quiet-holds.json")
STATE = os.path.expanduser("~/.local/state/machine-shepherd/quiet-window-state.json")
LOG = os.path.expanduser("~/.local/state/machine-shepherd/quiet-window.log")
MAD_LOG = os.path.expanduser("~/.local/state/machine-shepherd/mediaanalysisd-stopcont.log")
# machine-ok-queue's live tickets (one JSON per ticket, flock-held by its running process).
QUEUE = os.path.expanduser("~/.local/state/machine-ok/queue")
MAD_NAME, MAD_STOP_CPU, MAD_LEAD_MIN, MAD_RESUME_MIN = "mediaanalysisd", 50.0, 3, 15
# Agent name or pane id; names survive herdr pane moves (pane ids change on every move). An easl tile name works too.
SHEPHERD = open(os.path.expanduser("~/.config/machine-shepherd/pane")).read().strip() \
    if os.path.exists(os.path.expanduser("~/.config/machine-shepherd/pane")) else "shepherd"
HERDR = os.path.expanduser("~/.local/bin/herdr")
NOTICE_MIN, REPEAT_MIN = 10, 4
FULL_NOTICE_MIN, FULL_REMIND_MIN = 30, 5  # a full window: notice 30 min ahead, reminder 5 min ahead
# What a window asks of the agents it notifies, by level (Tim, 2026-10-07 07:05Z; bench-judge's notice ruling).
HEAVY = ("pause or queue only heavy processes (builds, dev servers, test runs, renders, encodes, benchmarks, "
         "game clients, screen captures); reading, coding, reviewing and subagents continue")
FULL = ("no heavy processes and no new processes, subagents, lanes or tool-executing agents on this Mac; "
        "reading and writing text only")
# The easl switch: {"enabled": true, "cli": "<easl path>"}. A missing or unreadable file,
# or "enabled" not true, keeps quiet-window herdr-only.
EASL_CONF = os.path.expanduser("~/.config/machine-shepherd/easl.json")
# herdr agents that run heavy work have an effort brief; Tim's own ad-hoc herdr sessions have none and are
# never messaged (2026-10-06: a hold notice landed in his fresh `terms` session). easl agent tiles need none.
EFFORTS = os.path.expanduser("~/cos/efforts")
# Fields new in easl R1, unconfirmed until it ships: a rename is a change here only.
TILE_PROTOCOL = "protocol"  # Agent: present once the tile's easl integration reports
DELIVERY = "delivery"  # agent.prompt result: "message", or "typed" when easl pasted into the terminal


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as f:
        json.dump(data, f, indent=1)
    os.replace(path + ".tmp", path)


def utc(text):
    return dt.datetime.strptime(text.rstrip("Z"), "%Y-%m-%dT%H:%M").replace(tzinfo=dt.timezone.utc)


def local(text):
    return utc(text).astimezone().strftime("%H:%M")


def log(msg):
    with open(LOG, "a") as f:
        f.write(f"{dt.datetime.now().strftime('%F %T')} {msg}\n")


AGENT_MSG = os.path.expanduser("~/.local/bin/agent-msg")


def prompt(pane, text):
    """Deliver through the agent's omp inbox (agent-msg: an aside at its next step, never
    typed into the terminal). agent-msg refuses (75) a pane without an inbox that is
    blocked or focused; the caller retries next tick. True when delivered."""
    cmd = [AGENT_MSG, "--from", "shepherd", pane, text] if os.path.exists(AGENT_MSG) \
        else [HERDR, "agent", "prompt", pane, text]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    log(f"msg {pane} rc={r.returncode}: {text[:120]}")
    return r.returncode == 0


def agents():
    """{pane id: agent name or None} for every herdr agent pane."""
    try:
        out = subprocess.run([HERDR, "agent", "list"], capture_output=True, text=True, timeout=20).stdout
        return {a["pane_id"]: a.get("name") for a in json.loads(out)["result"]["agents"]}
    except (ValueError, KeyError, subprocess.SubprocessError):
        return {}


def easl(*args):
    """stdout of the easl CLI when the switch is on and the call succeeds, else None (one stderr line
    on failure). The CLI's launcher execs bun, which launchd's PATH lacks."""
    try:
        with open(EASL_CONF) as f:
            conf = json.load(f)
        if conf.get("enabled") is not True:
            return None
    except (OSError, ValueError, AttributeError):
        return None
    env = {**os.environ, "PATH": os.path.expanduser("~/.bun/bin") + ":" + os.environ.get("PATH", "")}
    try:
        r = subprocess.run([conf.get("cli"), *args], capture_output=True, text=True, timeout=15, env=env)
        err = f"exit {r.returncode}: {' '.join(r.stderr.split())[-160:]}" if r.returncode else None
    except (OSError, TypeError, ValueError, subprocess.SubprocessError) as e:
        r, err = None, type(e).__name__
    if err:
        print(f"quiet-window: easl {args[0]} failed ({err})", file=sys.stderr)
        return None
    return r.stdout


def easl_tiles():
    """{tile id: easl Agent} for every easl agent tile; {} when the switch is off or the CLI fails."""
    out = easl("agent.list")
    if out is None:
        return {}
    try:
        return {t["tile"]: t for t in json.loads(out)["agents"] if isinstance(t, dict) and t.get("tile")}
    except (ValueError, KeyError, TypeError):
        print("quiet-window: easl agent.list printed no agent list; no easl tiles this run", file=sys.stderr)
        return {}


def tile_name(t):
    """A tile's display name: its agent name, else its tile id."""
    return t.get("name") or t["tile"]


def briefed(name):
    """True when agent `name` has an effort brief, so it may be told to hold or stop."""
    return bool(name) and "/" not in name and os.path.isfile(os.path.join(EFFORTS, name, "brief.md"))


def promptable(t):
    """Only an omp tile whose easl integration reports a protocol takes agent.prompt as a message;
    any other tile would get it pasted into its terminal."""
    return t.get("kind") == "omp" and type(t.get(TILE_PROTOCOL)) is int


def told(t):
    """True when tile t may be told to hold or stop: an omp tile with an easl protocol (>= 1) is an agent
    that runs work, briefed in ~/cos or only on its board; any other tile needs a ~/cos brief (and is then
    skipped by send(), never typed into). A tile with no agent name is Tim's own ad-hoc session (2026-10-07
    20:24Z: his unnamed tiktok tile got a STOP NOW): never told, only logged."""
    if not t.get("name"):
        return False
    return (promptable(t) and t[TILE_PROTOCOL] >= 1) or briefed(t.get("name"))


def queue_lane_pids(hold_id):
    """Pids of the queue's running tickets admitted to hold `hold_id`'s heavy-hold lane (background QoS)."""
    pids = set()
    try:
        names = os.listdir(QUEUE)
    except OSError:
        return pids
    for name in names:
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(QUEUE, name)) as f:
                r = json.load(f)
        except (OSError, ValueError):
            continue
        if r.get("state") == "running" and r.get("lane") == "heavy-hold" and r.get("hold") == hold_id \
                and isinstance(r.get("pid"), int):
            pids.add(r["pid"])
    return pids


def in_trees(pid, roots):
    """True when pid is one of roots or descends from one."""
    try:
        out = subprocess.run(["ps", "-axo", "pid=,ppid="], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    parent = {}
    for line in out.splitlines():
        p = line.split()
        if len(p) == 2 and p[0].isdigit() and p[1].isdigit():
            parent[int(p[0])] = int(p[1])
    seen = set()
    while pid > 1 and pid not in seen:
        if pid in roots:
            return True
        seen.add(pid)
        pid = parent.get(pid, 0)
    return False


def easl_prompt(t, text):
    """`agent.prompt` to tile t, addressed by tile id (a bare name can match several tiles). `--when now` steers a
    working agent mid-turn at its next step (`next-turn` waited for its turn to end: hours late). Returns its
    delivery ("unknown" when the result does not say), or None when the call failed."""
    out = easl("agent.prompt", "--target", t["tile"], "--text", text, "--from", "shepherd", "--when", "now")
    if out is None:
        return None
    try:
        return str(json.loads(out)[DELIVERY])
    except (ValueError, KeyError, TypeError):
        return "unknown"


def find(book, wid):
    """A window by id, or by an id it had before its owner's pane moved (former_ids)."""
    return next((w for w in book if w["id"] == wid or wid in w.get("former_ids", [])), None)


def interval_cpu():
    """{pid: (cpu %, command)} from a 1 s root interval sample (sudo top's second sample: its first
    reports lifetime averages)."""
    try:
        out = subprocess.run(["sudo", "-n", "top", "-l", "2", "-s", "1", "-stats", "pid,cpu,command"],
                             capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    rows = {}
    for line in out.split("Processes:")[-1].splitlines():
        m = re.match(r"\s*(\d+)\s+([\d.]+)\s+(.+?)\s*$", line)
        if m:
            rows[int(m.group(1))] = (float(m.group(2)), m.group(3))
    return rows


def mad_log(msg):
    with open(MAD_LOG, "a") as f:
        f.write(f"{dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')} {msg}\n")


def mediaanalysisd(state, windows, now):
    """Stop mediaanalysisd above MAD_STOP_CPU from MAD_LEAD_MIN before a window until its end; resume what
    this stopped once no window runs or starts within MAD_RESUME_MIN. state["_mad"] holds the pids it stopped."""
    stopped = state.setdefault("_mad", {})
    lead = dt.timedelta(minutes=MAD_LEAD_MIN)
    running = [w for w in windows if utc(w["start"]) - lead <= now < utc(w["end"])]
    if running:
        for pid, (cpu, cmd) in interval_cpu().items():
            if cmd == MAD_NAME and cpu > MAD_STOP_CPU and str(pid) not in stopped:
                try:
                    os.kill(pid, signal.SIGSTOP)
                except OSError as e:
                    mad_log(f"STOP pid {pid} failed ({e}) at {cpu:.0f}% during {running[0]['id']}")
                    continue
                stopped[str(pid)] = now.isoformat()
                mad_log(f"STOP pid {pid} at {cpu:.0f}% CPU during {running[0]['id']} ({running[0]['label']})")
        return
    soon = any(utc(w["start"]) - dt.timedelta(minutes=MAD_RESUME_MIN) <= now < utc(w["end"]) for w in windows)
    if soon:
        return
    for pid in list(stopped):
        try:
            os.kill(int(pid), signal.SIGCONT)
            mad_log(f"CONT pid {pid} (no window running or starting within {MAD_RESUME_MIN} min)")
        except OSError as e:
            mad_log(f"CONT pid {pid}: {e} (gone)")
        del stopped[pid]


def is_full(w):
    """True for a FULL QUIET window; a row without `quiet` (written before the levels) is heavy."""
    return w.get("quiet") == "full"


def why(w):
    """The reason a full window was booked with (the CLI requires one; a hand-edited row may lack it)."""
    return w.get("reason") or "none recorded"


def notice_text(w, span, unbooked, remind):
    """The notice for window w in its level's wording, or (full windows) its reminder."""
    who = f"for {w['label']} ({w['owner']})" + (" (unbooked hold: its driver refuses registry rows)" if unbooked else "")
    begin = local(w["start"])
    if is_full(w):
        head = f"REMINDER (starts at {begin} local): QUIET WINDOW" if remind else "QUIET WINDOW"
        return (f"shepherd: {head} {span} {who}. FULL QUIET across boards: {FULL}. Why: {why(w)}. "
                f"Finish or park everything that runs a process before {begin}.")
    return f"shepherd: QUIET WINDOW {span} {who}. Hold during it: {HEAVY}. Finish or park heavy work before {begin}."


def stop_text(w, span, procs):
    """The STOP NOW prompt to an agent whose processes load the machine during window w, in its level's wording."""
    kind = "FULL QUIET window" if is_full(w) else "Quiet window"
    rule = f"FULL QUIET across boards: {FULL}. Why: {why(w)}" if is_full(w) else HEAVY
    return (f"shepherd: STOP NOW. {kind} {span} for {w['label']} is running, and your processes are loading the "
            f"machine: {procs}. Stop or pause them until {local(w['end'])} local; {rule}.")


def tick():
    # Both registries always exist as JSON lists (written atomically, never deleted), so a reader such as
    # astra's quiet check can refuse a missing or malformed file instead of reading it as "no rows". A
    # malformed file is left as found: rewriting it would hide the corruption.
    for path in (BOOK, HOLDS):
        if not os.path.exists(path):
            save(path, [])
    book, holds, state = load(BOOK, []), load(HOLDS, []), load(STATE, {})
    now = dt.datetime.now(dt.timezone.utc)
    ags = tls = None

    def pane_of(x):
        """Current pane id of an agent name or pane id, else the tile id of the easl tile with that name or
        tile id (herdr first); None when no such agent runs."""
        nonlocal ags, tls
        if ags is None:
            ags, tls = agents(), easl_tiles()
        p = x if x in ags else next((p for p, n in ags.items() if n == x), None)
        if p is not None:
            return p
        return x if x in tls else next((i for i, t in tls.items() if t.get("name") == x), None)

    def send(s, target, text):
        """prompt() a herdr pane or agent. Where pane_of() resolves target to an easl tile, an omp tile with a
        protocol gets `agent.prompt` instead, and any other tile is skipped (a prompt would be typed into its
        terminal), as is a tile easl once typed into during this window. True when delivered or skipped."""
        key = pane_of(target)
        t = tls.get(key)
        if t is None:
            return prompt(target, text)
        tid, name = t["tile"], tile_name(t)
        if tid in s.get("typed", []) or not promptable(t):
            why = "easl typed into it earlier in this window" if tid in s.get("typed", []) else \
                f"kind {t.get('kind')!r}, protocol {t.get(TILE_PROTOCOL)!r}"
            log(f"skip easl tile {tid} ({name}): {why}; never typed into: {text[:120]}")
            return True
        delivery = easl_prompt(t, text)
        log(f"easl msg {tid} ({name}) delivery={delivery or 'failed'}: {text[:120]}")
        if delivery == "typed":
            warn = f"WARNING: easl TYPED into tile {tid} ({name}) instead of messaging it; no more prompts to it this window"
            log(warn)
            print(f"quiet-window: {warn}", file=sys.stderr)
            s.setdefault("typed", []).append(tid)
            return False
        return delivery is not None

    for w in book + holds:
        s = state.setdefault(w["id"], {"noticed": False, "started": False, "ended": False, "last": {}, "hits": {}})
        start, end = utc(w["start"]), utc(w["end"])
        span = f"{w['start'][11:16]}-{w['end'][11:16]}Z ({local(w['start'])}-{local(w['end'])} local)"
        lead = dt.timedelta(minutes=FULL_NOTICE_MIN if is_full(w) else NOTICE_MIN)
        if s["ended"] or not (start - lead <= now < end or (now >= end and s["started"])):
            continue
        owner, me = pane_of(w["owner"]), pane_of(SHEPHERD)
        if owner is None and not s.get("owner_missing"):
            log(f"owner {w['owner']} of {w['id']} not found in herdr")
            send(s, SHEPHERD, f"shepherd: quiet window {w['id']} names owner {w['owner']}, which no herdr agent "
                              f"matches (moved pane? use agent names); its own processes will count as offenders.")
            s["owner_missing"] = True
        # The notice (heavy: 10 min ahead; full: 30 min ahead) and, for a full window, the reminder 5 min ahead keep
        # separate state, so each is delivered once and retried at every tick for the recipients that refused it.
        due = [("noticed", "notice_pending", start - lead, False)]
        if is_full(w):
            due.append(("reminded", "remind_pending", start - dt.timedelta(minutes=FULL_REMIND_MIN), True))
        for done, pending, when, remind in due:
            if when <= now < end and (not s.get(done) or s.get(pending)):
                targets = s[pending] if s.get(done) else [
                    p for p, n in ags.items() if p not in (owner, me) and briefed(n)] + [
                    i for i, t in tls.items() if i not in (owner, me) and t.get("name") not in (w["owner"], SHEPHERD)
                    and told(t)]
                text = notice_text(w, span, w in holds, remind)
                s[pending] = [p for p in targets if (p in ags or p in tls) and not send(s, p, text)]
                s[done] = True
        if start <= now < end:
            s["started"] = True
            out = subprocess.run([os.path.expanduser("~/.local/bin/quiet-check"), "--pane", owner or w["owner"]],
                                 capture_output=True, text=True, timeout=60).stdout
            offenders = {}
            lane = queue_lane_pids(w["id"]) if not is_full(w) else set()
            for line in out.splitlines():
                if "<-- not quiet" not in line:
                    continue
                # A step the queue admitted to this heavy hold's background lane (bench's heavy-only-holds ruling:
                # one foreign slot at `taskpolicy -b`, nice 10) is allowed load, not an offender.
                pm = re.match(r"\s*[\d.]+%\s+(\d+)\s", line)
                if lane and pm and in_trees(int(pm.group(1)), lane):
                    continue
                # In a heavy window an agent's own omp runtime is never an offender, at any CPU: quiet-check tags it
                # "(agent runtime)" below 50% and flags it above, but reading, coding and subagents run inside it, and
                # its heavy children are named. A full window pauses tool-executing agents too, so there a hot omp counts.
                if not is_full(w) and re.match(r"\s*[\d.]+%\s+\d+\s+omp\s", line):
                    continue
                # Panes that share a project folder are listed as w2:pA|w2:pB; each of them is asked.
                m = re.match(r"\s*([\d.]+)%\s+(\d+)\s+(\S+)\s+(w\d+:p\w+(?:\|w\d+:p\w+)*)", line)
                if m:
                    for pane in m.group(4).split("|"):
                        if pane != owner:
                            offenders.setdefault(pane, []).append(f"{m.group(3)} pid {m.group(2)} {m.group(1)}%")
                elif "(easl tile " in line:
                    # quiet-check labels a tile's processes "<name> (easl tile <tile id>)"; it is asked by tile id.
                    tm = re.match(r"\s*([\d.]+)%\s+(\d+)\s+(\S+)\s.*\(easl tile (\S+)\)", line)
                    if tm and tm.group(4) != owner:
                        offenders.setdefault(tm.group(4), []).append(f"{tm.group(3)} pid {tm.group(2)} {tm.group(1)}%")
                elif "owner unknown" in line:
                    # A shared omp service child whose cwd matches no pane: the shepherd finds the owner.
                    u = re.match(r"\s*([\d.]+)%\s+(\d+)\s+(\S+)", line)
                    if u:
                        offenders.setdefault(me or SHEPHERD, []).append(
                            f"UNATTRIBUTED {u.group(3)} pid {u.group(2)} {u.group(1)}% (route to its owner)")
            if offenders:
                log(f"offenders in {w['id']}: {offenders}")
            for pane, procs in offenders.items():
                s["hits"][pane] = s["hits"].get(pane, 0) + 1
                last = s["last"].get(pane)
                name = tls[pane].get("name") if pane in tls else ags.get(pane)
                focused = pane in tls and tls[pane].get("focused")  # Tim is working in it: his call, not a STOP
                if pane != me and (focused or not (told(tls[pane]) if pane in tls else briefed(name))):
                    if last is None:
                        why_not = "Tim has it focused" if focused else "no effort brief (Tim's own session?)"
                        log(f"not prompting {name or pane}: {why_not}; {', '.join(procs)}")
                        s["last"][pane] = now.isoformat()
                    continue
                if last is None or now - dt.datetime.fromisoformat(last) >= dt.timedelta(minutes=REPEAT_MIN):
                    if send(s, pane, stop_text(w, span, ", ".join(procs))):
                        s["last"][pane] = now.isoformat()
        if now >= end and s["started"] and not s["ended"]:
            hits = ", ".join(f"{tile_name(tls[p]) if p in tls else p} x{n}" for p, n in s["hits"].items()) or "none"
            # A muted owner is busy with Tim (e.g. a live capture in its pane); the shepherd forwards later.
            targets = s["summary_pending"] if "summary_pending" in s else \
                [SHEPHERD] if w.get("mute_owner") else [w["owner"], SHEPHERD]
            s["summary_pending"] = [p for p in targets if not send(
                s, p, f"shepherd: quiet window {span} for {w['label']} ended. "
                      f"Panes caught loading the machine (minute samples): {hits}.")]
            # Retried each tick while a recipient refuses (blocked/focused, no inbox yet), for up to 30 min.
            s["ended"] = not s["summary_pending"] or now - end > dt.timedelta(minutes=30)
    mediaanalysisd(state, book + holds, now)
    old = now - dt.timedelta(hours=12)
    keep, keep_holds = [w for w in book if utc(w["end"]) > old], [w for w in holds if utc(w["end"]) > old]
    save(STATE, {**{w["id"]: state[w["id"]] for w in keep + keep_holds if w["id"] in state}, "_mad": state["_mad"]})
    if len(keep) != len(book):
        save(BOOK, keep)
    if len(keep_holds) != len(holds):
        save(HOLDS, keep_holds)


class Usage(argparse.ArgumentParser):
    def error(self, message):
        sys.exit(f"quiet-window: {message}\n\n{__doc__}")


def booking(cmd):
    """The registry row for `add|hold START END OWNER LABEL [--quiet heavy|full] [--reason TEXT]`. A full window
    without a reason is refused: the reason names the process classes it needs paused and the measured why."""
    ap = Usage(prog=f"quiet-window {cmd[0]}", add_help=False, allow_abbrev=False)
    for field in ("start", "end", "owner", "label"):
        ap.add_argument(field)
    ap.add_argument("--quiet", choices=("heavy", "full"), default="heavy")
    ap.add_argument("--reason")
    a = ap.parse_args(cmd[1:])
    reason = (a.reason or "").strip()
    if a.quiet == "full" and not reason:
        ap.error("--quiet full needs --reason: the process classes the run needs paused and the measured reason "
                 "(e.g. \"suite's sub-second latency bounds\")")
    row = {"id": f"{a.start}-{a.owner}" + ("" if cmd[0] == "add" else "-hold"), "start": a.start, "end": a.end,
           "owner": a.owner, "label": a.label, "quiet": a.quiet}
    if reason:
        row["reason"] = reason
    return row


def main():
    cmd = sys.argv[1:] or ["list"]
    book, holds = load(BOOK, []), load(HOLDS, [])
    if cmd[0] in ("add", "hold"):
        row = booking(cmd)
        if utc(row["end"]) <= utc(row["start"]):
            sys.exit("end must be after start")
        path, rows = (BOOK, book) if cmd[0] == "add" else (HOLDS, holds)
        rows = [w for w in rows if w["id"] != row["id"]] + [row]
        save(path, sorted(rows, key=lambda w: w["start"]))
        print(f"{'booked' if cmd[0] == 'add' else 'held (not in the registry)'} {row['id']}")
    elif cmd[0] in ("remove", "mute") and len(cmd) == 2:
        path, rows = (BOOK, book) if find(book, cmd[1]) else (HOLDS, holds)
        w = find(rows, cmd[1])
        if w is None:
            sys.exit(f"no window {cmd[1]}; booked: {', '.join(x['id'] for x in book + holds) or 'none'}")
        now = dt.datetime.now(dt.timezone.utc)
        if cmd[0] == "mute":
            w["mute_owner"] = True
            save(path, rows)
            print(f"end summary of {w['id']} goes to the shepherd only")
        elif utc(w["start"]) <= now < utc(w["end"]):
            # Deleting a running window would drop its catch history before the end summary.
            w["end"] = now.strftime("%Y-%m-%dT%H:%MZ")
            save(path, rows)
            print(f"ended {cmd[1]} at {w['end']}; the summary follows within a minute")
        else:
            save(path, [x for x in rows if x is not w])
            print(f"removed {w['id']}")
    elif cmd[0] == "list":
        for w in sorted(book + holds, key=lambda x: x["start"]):
            print(f"{w['id']}  {w['start']} -> {w['end']}  ({local(w['start'])}-{local(w['end'])} local)  "
                  f"{w['owner']}  {w['label']}{f'  [FULL QUIET: {why(w)}]' if is_full(w) else ''}"
                  f"{'  [HOLD: unbooked, not in the registry]' if w in holds else ''}")
    elif cmd[0] == "tick":
        tick()
    else:
        sys.exit(__doc__)


main()
