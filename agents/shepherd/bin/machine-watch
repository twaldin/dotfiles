#!/usr/bin/python3
"""machine-watch: print one machine-health JSON report on demand.

Combines machine-census's memory, CPU and owner footprints with a five-second
FSEvents sample, ColorSync request/profile rates over the last 120 seconds,
WindowServer pid and input-idle seconds. Unavailable optional measurements are
null. A failed census exits 1 without a report.

Usage: machine-watch
No state files, alerts, messages, remote probes or scheduled/continuous mode.
"""
import argparse
import json
import os
import re
import subprocess
import sys

BIN = os.path.expanduser("~/.local/bin")


def run(cmd, timeout=60):
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return result.stdout if result.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def fsevents(seconds=5):
    out = run([os.path.join(BIN, "fsevents-top"), str(seconds), "5", "3"], timeout=seconds + 20)
    m = re.search(r"(\d+) events \(([\d.]+)/s\), (\d+) unique paths, dropped=(\d+)", out)
    rows = re.findall(r"^\s+(\d+)\s+([\d.]+)%\s+(\d+)\s+(.+)$", out, re.M)
    return {
        "rate": float(m.group(2)) if m else None,
        "unique": int(m.group(3)) if m else None,
        "dropped": int(m.group(4)) if m else None,
        "top": [{"events": int(e), "share": float(s), "uniq": int(u), "prefix": p} for e, s, u, p in rows],
    }


def colorsync_rate(seconds=120):
    """Recent display-info requests/s and device-profile builds/s, or unknown."""
    out = run(["log", "show", "--style", "compact", "--last", f"{seconds}s", "--predicate",
               'process == "colorsync.displayservices" AND (eventMessage BEGINSWITH '
               '"ColorSyncDisplayServicesAgent: received XPC_DISPLAY_INFO_REQUEST" OR eventMessage BEGINSWITH '
               '"ColorSyncProfileCreateDeviceProfile")'], timeout=60)
    if not out.strip():
        return None
    lines = out.splitlines()
    return {"requests_ps": round(sum("XPC_DISPLAY_INFO_REQUEST" in line for line in lines) / seconds, 2),
            "profiles_ps": round(sum("ColorSyncProfileCreateDeviceProfile" in line for line in lines) / seconds, 2)}


def windowserver_pid():
    """The running WindowServer's pid, or unknown when neither probe can see it."""
    out = run(["sudo", "-n", "pgrep", "-x", "WindowServer"], timeout=10) or run(["pgrep", "-x", "WindowServer"], timeout=10)
    return int(out.split()[0]) if out.split() else None


def hid_idle_s():
    """Seconds since keyboard, mouse or trackpad input (IOHIDSystem), or unknown."""
    out = run(["ioreg", "-c", "IOHIDSystem", "-r", "-d", "1", "-k", "HIDIdleTime"], timeout=10)
    m = re.search(r'"HIDIdleTime" = (\d+)', out)
    return int(m.group(1)) / 1e9 if m else None


def main():
    argparse.ArgumentParser(description=__doc__).parse_args()
    os.nice(10)
    try:
        report = json.loads(run([os.path.join(BIN, "machine-census"), "--json", "--sample", "2"], timeout=120))
    except json.JSONDecodeError:
        print("machine-watch: census failed", file=sys.stderr)
        return 1
    report.update(fsevents=fsevents(), colorsync=colorsync_rate(),
                  windowserver_pid=windowserver_pid(), hid_idle_s=hid_idle_s())
    print(json.dumps(report))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
