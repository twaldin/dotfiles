#!/usr/bin/python3
"""machine-watch: record machine health, wake the shepherd agent on pressure, and stop CPU hogs while Tim types.

Every full run (launchd ticks `machine-watch --tick` every minute; every other tick is a full run, so
every ~2 minutes) appends one JSON line to
~/.local/state/machine-watch.jsonl with memory, CPU, per-group footprints,
per-agent footprints, fseventsd size and the FSEvents rate with its top source.
When a rule trips it messages the shepherd agent named in
~/.config/machine-shepherd/pane through `agent-msg` (omp inbox; plain `herdr agent prompt` where agent-msg is not installed), once per rule per
cooldown. A machine without that file queues alerts in
~/.local/state/machine-watch.alerts instead; the shepherd's machine lists such
hosts in ~/.config/machine-shepherd/remotes, pulls their queued alerts over ssh
each run, and flags a remote whose watcher stops reporting. Hosts listed in
~/.config/machine-shepherd/broker-clients (one ssh target per line) run omp in broker
mode against this machine's auth broker: every 5 minutes it checks, FROM each client,
that the broker URL in the client's config.yml answers /v1/healthz and accepts the
client's token, and alerts when that has failed for 10 minutes (clients lose
credentials ~1 h after the broker becomes unreachable). It never kills
anything: diagnosis and reclaiming stay with the shepherd, and kills that are
not already automated need Tim's approval.
Hosts listed in ~/.config/machine-shepherd/patch-hosts (`<ssh target> [unit ...]` per line) are
probed every 6 hours for their patch state: kernel, uptime, /var/run/reboot-required and its
packages, pending updates, package-list and unattended-upgrades age, and whether the listed units
are active. The shepherd gets one status line per host per day, and an urgent alert (cooldown 1 h)
as soon as a listed unit is not active.
With ~/.config/machine-shepherd/easl.json enabled, a shepherd name that names an omp easl
tile with an easl protocol gets alerts through `easl agent.prompt` instead of agent-msg.

Active-time saturation (the fast rule): while Tim is active (keyboard or pointer input within the last 60 s,
ioreg's HIDIdleTime), every tick first samples system CPU for 2 s (iostat). Two consecutive active-time checks
under 15% idle, so within 2 minutes of the onset, find the top 3 CPU consumers (a job is an omp's tool command
with everything it started, else launchd's child with its descendants) and message each consumer's owning agent:
its omp's easl tile (the zmx server's canvas.tile label above the omp, else the omp's EASL_TILE_ID), else its
herdr pane (HERDR_PANE_ID); a job launchd adopted maps through its own EASL_TILE_ID. The message asks the agent to
stop the job and rerun it through machine-ok-queue or offload with less parallelism, at most once per owner and
job (executable) per 10 minutes, for jobs using a core or more. The shepherd gets one line naming whom it
messaged. Tim's apps, Tim's own tiles (an easl tile with no agent name, or the one he has focused), macOS
(kernel_task, WindowServer, daemons), zmx, brokers and omp runtimes are never messaged about, only listed for the
shepherd. While the CPU is saturated and Tim active, a full run waits (up to
5 minutes) so the checks keep their pace. Each active-time check is a line in machine-watch.fast.jsonl. While
Tim is idle, saturation is the slow rule's (cpu_saturated: 3 full runs, shepherd only).
`machine-watch --consumers` prints the top consumers, their owners and the messages, and sends nothing.

usage: machine-watch [--tick] [--dry-run] [--no-alert] | --consumers | --ack-colorsync
"""
import argparse
import functools
import json
import os
import pwd
import re
import shlex
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
BIN = os.path.join(HOME, ".local/bin")
STATE_DIR = os.path.join(HOME, ".local/state")
LOG = os.path.join(STATE_DIR, "machine-watch.jsonl")
STATE = os.path.join(STATE_DIR, "machine-watch.state.json")
PANE_FILE = os.path.join(HOME, ".config/machine-shepherd/pane")
REMOTES = os.path.join(HOME, ".config/machine-shepherd/remotes")
BROKER_CLIENTS = os.path.join(HOME, ".config/machine-shepherd/broker-clients")
BROKER_EVERY_S, BROKER_ALERT_S = 300, 600
PATCH_HOSTS = os.path.join(HOME, ".config/machine-shepherd/patch-hosts")
PATCH_EVERY_S, PATCH_REPORT_S = 6 * 3600, 24 * 3600
PATCH_STALE_H = 72  # package lists or unattended-upgrades older than this: the daily apt jobs stopped
ALERTS = os.path.join(STATE_DIR, "machine-watch.alerts")
LOG_MAX_BYTES = 20 * 1024 * 1024
COOLDOWN_S = 60 * 60
# The easl switch: {"enabled": true, "cli": "<easl path>"}. A missing or unreadable file,
# or "enabled" not true, keeps delivery on agent-msg.
EASL_CONF = os.path.join(HOME, ".config/machine-shepherd/easl.json")
# Fields new in easl R1, unconfirmed until it ships: a rename is a change here only.
TILE_PROTOCOL = "protocol"  # Agent: present once the tile's easl integration reports
DELIVERY = "delivery"  # agent.prompt result: "message", or "typed" when easl pasted into the terminal

# The fast rule (see the docstring). FULL_EVERY_S is under 120 so launchd's 60 s ticks alternate light and full.
ACTIVE_S = 60
FULL_EVERY_S, FULL_DEFER_S = 110, 300
FAST_IDLE_PCT, FAST_STREAK, FAST_GAP_S, FAST_SAMPLE_S = 15, 2, 150, 2
OWNER_COOLDOWN_S, OWNER_MIN_CPU = 600, 100.0
FAST_LOG = os.path.join(STATE_DIR, "machine-watch.fast.jsonl")
TIM_APPS = ("/google chrome.app/", "/search.app/", "/easl.app/")
SYSTEM_PATHS = ("/System/", "/usr/libexec/", "/usr/sbin/", "/sbin/")
ME = pwd.getpwuid(os.geteuid()).pw_name

# Thresholds. "streak" rules must hold for that many consecutive runs.
RULES = {
    "memory_free_low": {"msg": "memory free {free_pct}% (<20%)", "streak": 1},
    "compressed_high": {"msg": "compressor holds {compressed_gb} GB (>30% of RAM), memory free {free_pct}%; largest holder {cmprs_top_name} {cmprs_top_pid} with {cmprs_top_mb} MB compressed", "streak": 2},
    "swap_growing": {"msg": "swap grew {swap_delta_gb:+.1f} GB in 30 min (now {swap_used_gb} GB); memory free fell to {swap_min_free}% (now {free_pct}%)", "streak": 1},
    "fseventsd_big": {"msg": "fseventsd footprint {fseventsd_mb:.0f} MB (>1024)", "streak": 1},
    "fsevents_storm": {"msg": "FSEvents {fsevents_rate:.0f}/s, top source {fsevents_top} ({fsevents_top_share:.0f}%)", "streak": 2},
    "agent_huge": {"msg": "omp agent {grow_pid} ({grow_pane}, {grow_project}) at {grow_mb} MB ({grow_delta_mb:+.0f} MB in the last hour) with memory free {free_pct}%", "streak": 2},
    "browser_big": {"msg": "omp headless browser {browser_mb:.0f} MB in {browser_procs} procs, memory free {free_pct}%", "streak": 2},
    "windowserver_hot": {"msg": "WindowServer {windowserver_cpu:.0f}% CPU (>60%)", "streak": 3},
    # While Tim is idle only (evaluate()); while he is active the fast rule owns saturation.
    "cpu_saturated": {"msg": "CPU idle {cpu_idle:.0f}% (<15%)", "streak": 3},
    "colorsync_ratchet": {"msg": "ColorSync rebuilds {cs_profiles:.0f} display profiles/s ({cs_requests:.1f} requests/s) on WindowServer pid {ws_pid}, above its alert level of {cs_ack_level:.1f}/s: virtual-display changes are ratcheting WindowServer again (it crashed at ~46/s on 09-29); sky-lead asked to be told", "streak": 3},
    # Streak counted per omp pid (SPIN_RUNS) inside evaluate(), so the rule itself needs one run.
    "omp_spin": {"msg": "omp {spin_pid} ({spin_pane}, {spin_project}) used {spin_cpu:.0f}% CPU itself in each of the last {spin_runs} runs; herdr status {spin_status}; kernel time {spin_sys}. A spinning omp burns CPU whatever herdr shows, and only a root sample sees it; ask its owner before restarting it", "streak": 1},
}
SPIN_CPU, SPIN_RUNS = 100.0, 5


def run(cmd, timeout=60):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ""


def fsevents(seconds=5):
    out = run([os.path.join(BIN, "fsevents-top"), str(seconds), "5", "3"], timeout=seconds + 20)
    m = re.search(r"(\d+) events \(([\d.]+)/s\), (\d+) unique paths, dropped=(\d+)", out)
    rows = re.findall(r"^\s+(\d+)\s+([\d.]+)%\s+(\d+)\s+(.+)$", out, re.M)
    return {
        "rate": float(m.group(2)) if m else None,
        "unique": int(m.group(3)) if m else None,
        "dropped": int(m.group(4)) if m else None,
        "top": [{"events": int(e), "share": float(s), "uniq": int(u), "prefix": p} for e, s, u, p in rows],
    }


def colorsync_rate(seconds=120):
    """WindowServer -> colorsync.displayservices display-info requests/s, and device-profile builds/s.

    Recorded, not alerted on (2026-09-29): on twaldin-home the request rate ratcheted from 2.2/s
    to ~10/s as agents created BetterDisplay virtual screens and never came back down, holding
    ~0.9 core in ColorSync and 80 WindowServer threads blocked. Each request rebuilds one profile
    per display. While ColorSync is saturated, profile builds/s stays constant (~46/s on home),
    and requests/s only reflects how many displays exist: 9/s with 5, 15/s with 3. Below
    saturation, requests/s is WindowServer's real demand."""
    out = run(["log", "show", "--style", "compact", "--last", f"{seconds}s", "--predicate",
               'process == "colorsync.displayservices" AND (eventMessage BEGINSWITH '
               '"ColorSyncDisplayServicesAgent: received XPC_DISPLAY_INFO_REQUEST" OR eventMessage BEGINSWITH '
               '"ColorSyncProfileCreateDeviceProfile")'], timeout=60)
    if not out.strip():
        return None  # query failed or timed out; a false 0 would poison the ratchet baseline for 6 h
    lines = out.splitlines()
    return {"requests_ps": round(sum("XPC_DISPLAY_INFO_REQUEST" in l for l in lines) / seconds, 2),
            "profiles_ps": round(sum("ColorSyncProfileCreateDeviceProfile" in l for l in lines) / seconds, 2)}


def windowserver_pid():
    """The running WindowServer's pid, or None. `sudo -n` first: agent panes cannot see it unprivileged."""
    out = run(["sudo", "-n", "pgrep", "-x", "WindowServer"], timeout=10) or run(["pgrep", "-x", "WindowServer"], timeout=10)
    return int(out.split()[0]) if out.split() else None


def hid_idle_s():
    """Seconds since Tim's last keyboard, mouse or trackpad input (IOHIDSystem's HIDIdleTime), or None."""
    out = run(["ioreg", "-c", "IOHIDSystem", "-r", "-d", "1", "-k", "HIDIdleTime"], timeout=10)
    m = re.search(r'"HIDIdleTime" = (\d+)', out)
    return int(m.group(1)) / 1e9 if m else None


def cpu_idle_sample(seconds=FAST_SAMPLE_S):
    """System-wide CPU idle % over the next `seconds` (iostat's second report), or None."""
    lines = run(["iostat", "-n", "0", "-c", "2", "-w", str(seconds)], timeout=seconds + 20).splitlines()
    head = next((line.split() for line in lines if "id" in line.split()), None)
    try:
        return float(lines[-1].split()[head.index("id")])
    except (AttributeError, IndexError, ValueError):
        return None


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except Exception:
        return {"streaks": {}, "last_alert": {}, "swap_hist": []}


def save_state(state):
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, STATE)


def append_log(rec, path=LOG):
    if os.path.exists(path) and os.path.getsize(path) > LOG_MAX_BYTES:
        os.replace(path, path + ".1")
    with open(path, "a") as f:
        f.write(json.dumps(rec, separators=(",", ":")) + "\n")


def evaluate(c, fs, state, now, cs=None, ws=None, active=False):
    mem = c["memory"]
    g = c["groups"]
    group = lambda name, key: g.get(name, {}).get(key, 0)
    hist = [h for h in state.get("swap_hist", []) if now - h[0] <= 1900] + [[now, mem["swap_used_gb"], mem["free_pct"]]]
    # Lowest free% over the same ~30 min window; entries written before 2026-09-29 have no free% field.
    swap_min_free = min((h[2] for h in hist if len(h) > 2 and h[2] is not None), default=100)
    state["swap_hist"] = hist
    old = [h for h in hist if now - h[0] >= 1500]
    swap_delta = mem["swap_used_gb"] - old[0][1] if old else 0.0
    agents = c.get("agents") or []
    big = max(agents, key=lambda a: a["mem_mb"], default=None)
    # Per-agent size history (~65 min) so agent_huge can tell growth from a stable size.
    ahist = state.get("agent_hist", {})
    ahist = {str(a["pid"]): [h for h in ahist.get(str(a["pid"]), []) if now - h[0] <= 3900] + [[now, a["mem_mb"]]] for a in agents}
    state["agent_hist"] = ahist

    def growth(pid):
        # vs the newest sample >= 50 min old; a younger agent is measured from when first seen
        h = ahist.get(str(pid), [])
        old = [x for x in h if now - x[0] >= 3000] or h[:1]
        return h[-1][1] - old[-1][1] if h else 0
    hot = [a for a in agents if a["mem_mb"] > 6144 or (a["mem_mb"] > 3072 and growth(a["pid"]) > 1024)]
    grow = max(hot, key=lambda a: a["mem_mb"], default=None)
    # Consecutive runs (~2 min apart) in which each omp's own CPU, from census's root interval sample,
    # exceeded SPIN_CPU. canvas's omp ran at ~400%, mostly kernel time, for 95 min on 10-06 while it
    # looked idle; unprivileged ps/top in agent panes showed 0.5-10%.
    spin = state.get("spin", {})
    spin = {str(a["pid"]): spin.get(str(a["pid"]), 0) + 1 for a in agents if (a.get("cpu") or 0) > SPIN_CPU}
    state["spin"] = spin
    spinner = max((a for a in agents if spin.get(str(a["pid"]), 0) >= SPIN_RUNS), key=lambda a: a["cpu"], default=None)
    # Alert level for ColorSync profile builds/s: 5 on a WindowServer nobody acknowledged, else the
    # acknowledged level + 3. An acknowledgement from before a WindowServer restart no longer applies.
    ack = state.get("cs_ack") or {}
    cs_ack_level = ack["profiles_ps"] + 3 if ws is not None and ack.get("ws") == ws else 5
    top = fs["top"][0] if fs["top"] else {"prefix": "-", "share": 0}
    v = {
        "free_pct": mem["free_pct"],
        "compressed_gb": mem["compressed_gb"],
        "swap_used_gb": mem["swap_used_gb"],
        "swap_delta_gb": swap_delta,
        "swap_min_free": swap_min_free,
        "fseventsd_mb": group("fseventsd", "mem_mb"),
        "fsevents_rate": fs["rate"] or 0,
        "fsevents_top": top["prefix"],
        "fsevents_top_share": top["share"],
        "agent_pid": big["pid"] if big else None,
        "agent_pane": big["pane"] if big else None,
        "agent_project": big["project"] if big else None,
        "agent_mb": big["mem_mb"] if big else 0,
        "grow_pid": grow["pid"] if grow else None,
        "grow_pane": grow["pane"] if grow else None,
        "grow_project": grow["project"] if grow else None,
        "grow_mb": grow["mem_mb"] if grow else 0,
        "grow_delta_mb": growth(grow["pid"]) if grow else 0,
        "browser_mb": group("omp headless browser", "mem_mb"),
        "browser_procs": group("omp headless browser", "procs"),
        "windowserver_cpu": group("WindowServer", "cpu"),
        "cpu_idle": c["cpu_idle"] if c["cpu_idle"] is not None else 100,
        "cs_profiles": cs["profiles_ps"] if cs else 0,
        "cs_requests": cs["requests_ps"] if cs else 0,
        "ws_pid": ws,
        "cs_ack_level": cs_ack_level,
        # Census records from before 09-30 have no top_compressed; 0 keeps the rule on the free% branch.
        "cmprs_top_name": (c.get("top_compressed") or [{}])[0].get("name", "-"),
        "cmprs_top_pid": (c.get("top_compressed") or [{}])[0].get("pid"),
        "cmprs_top_mb": (c.get("top_compressed") or [{}])[0].get("cmprs_mb", 0),
        "spin_pid": spinner["pid"] if spinner else None,
        "spin_pane": spinner["pane"] if spinner else None,
        "spin_project": spinner["project"] if spinner else None,
        "spin_cpu": spinner["cpu"] if spinner else 0,
        "spin_runs": spin[str(spinner["pid"])] if spinner else 0,
        "spin_status": "-",
        "spin_sys": "-",
    }
    tripped = {
        "memory_free_low": v["free_pct"] is not None and v["free_pct"] < 20,
        # The compressor rule exists for a single hoarder: fseventsd held 14 GB almost all compressed while
        # free% read 53%. Many small holders at 50%+ free is normal on a 14-agent box; it fired three times
        # on 09-29/30 with no holder above 1.7 GB. So: over 30% of RAM AND (memory short, or one process
        # holding > 3 GB compressed; the Remotion render at 3.9 GB was worth knowing about).
        "compressed_high": v["compressed_gb"] > 0.30 * mem["total_gb"]
                           and ((v["free_pct"] is not None and v["free_pct"] < 50) or v["cmprs_top_mb"] > 3072),
        # Swap growth alone is not pressure: on twaldin-work the used-swap figure moves 2-3 GB while
        # free memory stays above 50% (19:28 on 09-29: +2.4 GB, lowest free 34%, 36 swap ops/s). Count
        # it only when memory actually got tight in that window. Replayed over work's history, this
        # cut 18 alerts to 12 and kept every alert where free memory fell to 26%.
        "swap_growing": swap_delta > 2.0 and swap_min_free < 30,
        "fseventsd_big": v["fseventsd_mb"] > 1024,
        "fsevents_storm": v["fsevents_rate"] > 3000,
        # A big session is only worth waking the shepherd for once memory is short, and only
        # while it grows: a long-lived coordinator sits at 2.5-3.6 GB for a day (work's Canvas
        # seat 96859), and "over 3 GB with free < 50%" re-alerted on it hourly for nothing.
        # Growth > 1 GB/h catches a leak; > 6 GB catches a burst (subagent fan-outs hit 8.8-11.3).
        "agent_huge": grow is not None and v["free_pct"] is not None and v["free_pct"] < 50,
        # Size alone is normal use (p23's live 3D app tabs held 2.2 GB at 74% free), so it
        # only matters once memory is short; a runaway process count is the leak signature.
        "browser_big": v["browser_procs"] > 40 or (v["browser_mb"] > 2048 and v["free_pct"] is not None and v["free_pct"] < 50),
        # Saturation at idle time: never evaluated before 10-07 (16:48-17:25Z sat at 0.1-0.4% idle unreported).
        # While Tim is active the fast rule acts on it within 2 minutes instead.
        "cpu_saturated": not active and v["cpu_idle"] < 15,
        # A WindowServer that rebuilds display profiles continuously has the restore_color_preferences
        # ratchet: each virtual-display change adds demand that only a restart clears. A healthy one sits
        # near 0; it saturated at ~46/s and the 80 blocked threads crashed WindowServer (16:24, 09-29).
        # `machine-watch --ack-colorsync` records the current WindowServer and level as known, so the rule
        # fires again only on a further rise (>3/s over that level), not hourly; a new WindowServer starts
        # from 5/s. A rise-over-recent-low rule false-alarmed at 16:05 on 09-29, when saturated throughput
        # dipped to 26/s once.
        "colorsync_ratchet": cs is not None and ws is not None and cs["profiles_ps"] > cs_ack_level,
        "omp_spin": spinner is not None,
    }
    fire = []
    for rule, hit in tripped.items():
        streak = state["streaks"].get(rule, 0) + 1 if hit else 0
        state["streaks"][rule] = streak
        last = state["last_alert"].get(rule)
        if hit and streak >= RULES[rule]["streak"] and (last is None or now - last >= COOLDOWN_S):
            fire.append(rule)
    return v, fire


def spin_detail(pid, pane):
    """herdr's status for the spinning omp's pane, and its kernel share of CPU time over 2 s (root ps:
    an agent pane's own ps cannot read other users' processes reliably)."""
    status = "unknown"
    try:
        out = run([os.path.join(BIN, "herdr"), "agent", "list"], timeout=20)
        status = next((a.get("agent_status") or "none" for a in json.loads(out)["result"]["agents"]
                       if a.get("pane_id") == pane), "not in herdr")
    except (ValueError, KeyError, TypeError):
        pass

    def times():
        out = run(["sudo", "-n", "ps", "-o", "utime=,stime=", "-p", str(pid)], timeout=20).split()
        secs = lambda t: sum(float(x) * 60 ** i for i, x in enumerate(reversed(t.split(":"))))
        return (secs(out[0]), secs(out[1])) if len(out) == 2 else None
    a = times()
    time.sleep(2)
    b = times()
    if a and b and (b[0] - a[0]) + (b[1] - a[1]) > 0:
        sys_share = f"{100 * (b[1] - a[1]) / ((b[0] - a[0]) + (b[1] - a[1])):.0f}% of its CPU over 2 s"
    else:
        sys_share = "n/a (no root ps sample)"
    return status, sys_share


def shepherd_pane():
    try:
        with open(PANE_FILE) as f:
            return f.read().strip()
    except OSError:
        return ""


def easl(*args):
    """stdout of the easl CLI when the switch is on and the call succeeds, else None (one stderr line
    on failure). The CLI's launcher execs bun, which launchd's PATH lacks."""
    try:
        with open(EASL_CONF) as f:
            conf = json.load(f)
        if conf.get("enabled") is not True:
            return None
    except (OSError, ValueError, AttributeError):
        return None
    env = {**os.environ, "PATH": os.path.join(HOME, ".bun/bin") + ":" + os.environ.get("PATH", "")}
    try:
        r = subprocess.run([conf.get("cli"), *args], capture_output=True, text=True, timeout=15, env=env)
        err = f"exit {r.returncode}: {' '.join(r.stderr.split())[-160:]}" if r.returncode else None
    except (OSError, TypeError, ValueError, subprocess.SubprocessError) as e:
        r, err = None, type(e).__name__
    if err:
        print(f"machine-watch: easl {args[0]} failed ({err})", file=sys.stderr)
        return None
    return r.stdout


@functools.lru_cache(maxsize=None)
def easl_tiles():
    """Every easl agent tile (`agent.list`, once per run); () when the switch is off or the CLI fails."""
    out = easl("agent.list")
    if out is None:
        return ()
    try:
        return tuple(t for t in json.loads(out)["agents"] if isinstance(t, dict) and t.get("tile"))
    except (ValueError, KeyError, TypeError):
        print("machine-watch: easl agent.list printed no agent list; no easl tiles this run", file=sys.stderr)
        return ()


def shepherd_tile(name):
    """The easl tile with this tile id, else the first with this agent name; None when there is none."""
    tiles = easl_tiles()
    return next((t for t in tiles if t["tile"] == name), None) or next((t for t in tiles if t.get("name") == name), None)


def tile_prompt(t, text):
    """`agent.prompt` to tile t, steering it mid-turn when busy (`--when now`: next-turn delivery waited hours for
    busy agents on 2026-10-07), addressed by tile id (a bare name can match several tiles).
    True when sent; a "typed" delivery means easl pasted into the terminal, which counts as a failure."""
    out = easl("agent.prompt", "--target", t["tile"], "--text", text, "--from", "machine-watch", "--when", "now")
    if out is None:
        return False
    try:
        delivery = str(json.loads(out)[DELIVERY])
    except (ValueError, KeyError, TypeError):
        delivery = "unknown"
    if delivery == "typed":
        print(f"machine-watch: WARNING: easl TYPED the alert into tile {t['tile']} instead of messaging it", file=sys.stderr)
        return False
    print(f"machine-watch: alert to easl tile {t['tile']}: delivery {delivery}", file=sys.stderr)
    return True


def pane_prompt(pane, text):
    """agent-msg (omp inbox; plain `herdr agent prompt` where agent-msg is not installed) to a herdr pane; True when sent.
    agent-msg never types into the pane; it refuses (75) a blocked/focused pane that has no inbox yet."""
    msg = os.path.join(BIN, "agent-msg")
    cmd = [msg, "--from", "machine-watch", pane, text] if os.path.exists(msg) \
        else [os.path.join(BIN, "herdr"), "agent", "prompt", pane, text]
    return subprocess.run(cmd, capture_output=True, timeout=60).returncode == 0


def deliver(text, reasons, urgent, dry):
    """Prompt the shepherd pane; on a machine without one, queue for the relay. An omp easl tile with a
    protocol (easl switch on) gets it through `easl agent.prompt`; any other tile is never prompted."""
    pane = shepherd_pane()
    if dry:
        print("ALERT ->", pane or "(queue)", ":", text)
        return
    if not pane:
        with open(ALERTS, "a") as f:
            f.write(json.dumps({"ts": int(time.time()), "text": text}) + "\n")
        return
    tile = shepherd_tile(pane)
    if tile is not None and tile.get("kind") == "omp" and type(tile.get(TILE_PROTOCOL)) is int:
        delivered = tile_prompt(tile, text)
    else:
        if tile is not None:
            # agent.prompt would be typed into this tile's terminal; agent-msg reaches herdr panes only.
            print(f"machine-watch: skipped easl tile {tile['tile']} ({pane}): kind {tile.get('kind')!r}, "
                  f"protocol {tile.get(TILE_PROTOCOL)!r}; trying agent-msg", file=sys.stderr)
        delivered = pane_prompt(pane, text)
    if not delivered or urgent:
        subprocess.run(["osascript", "-e", f"display notification {json.dumps(reasons)} with title \"machine-watch\""],
                       capture_output=True, timeout=10)


def notify(c, fs, v, fire, dry):
    groups = sorted(c["groups"].items(), key=lambda kv: -kv[1]["mem_mb"])[:4]
    top = ", ".join(f"{k} {d['mem_mb'] / 1024:.1f}GB/{d['cpu']:.0f}%" for k, d in groups)
    reasons = "; ".join(RULES[r]["msg"].format(**v) for r in fire)
    text = (f"[machine-watch {c['host']}] {reasons}. Top groups: {top}. "
            f"Diagnose with machine-census and fsevents-top; ask Tim before killing anything not already automated.")
    deliver(text, reasons, "memory_free_low" in fire, dry)


def proc_table():
    """{pid: {pid, ppid, user, cpu_s (cumulative CPU seconds), cmd}} from one ps; root first, as in machine-census."""
    args = ["ps", "-axww", "-o", "pid=,ppid=,user=,time=,command="]
    procs = {}
    for line in (run(["sudo", "-n", *args], timeout=30) or run(args, timeout=30)).splitlines():
        parts = line.split(None, 4)
        if len(parts) < 5 or not parts[0].isdigit():
            continue
        try:
            cpu_s = sum(float(x) * 60 ** i for i, x in enumerate(reversed(parts[3].split(":"))))
        except ValueError:
            continue
        procs[int(parts[0])] = {"pid": int(parts[0]), "ppid": int(parts[1]), "user": parts[2], "cpu_s": cpu_s, "cmd": parts[4]}
    return procs


def consumers(seconds=FAST_SAMPLE_S):
    """Every process with "cpu": % of one core it used over `seconds` (the CPU time two ps samples differ by)."""
    before = proc_table()
    t0 = time.monotonic()
    time.sleep(seconds)
    procs = proc_table()
    dt = max(time.monotonic() - t0, 0.1)
    for pid, p in procs.items():
        p["cpu"] = max(p["cpu_s"] - before[pid]["cpu_s"] if pid in before else p["cpu_s"], 0.0) * 100 / dt
    return procs


def exe_path(cmd):
    """The executable's path: up to the first space, or through an app bundle's executable, whose name may hold spaces
    (/Applications/Google Chrome.app/Contents/MacOS/Google Chrome; a framework's Python.app runs every python3)."""
    m = re.match(r"(/[^ ]*(?: [^-][^ ]*)*?/([^/]+)\.app/Contents/MacOS/\2)(?= |$)", cmd)
    return m.group(1) if m else cmd.split(" ", 1)[0]


def exe_name(cmd):
    return os.path.basename(exe_path(cmd))


def short_cmd(cmd):
    """The command line without its executable's directory, so its owner recognises it in 80 characters."""
    path = exe_path(cmd)
    return os.path.basename(path) + cmd[len(path):]


def is_broker(cmd):
    """omp's shared daemon broker, the auth gateway (broker) and its runner."""
    return re.search(r"__omp_worker_daemon_broker|\bauth-gateway\b|run-broker|auth-broker", cmd) is not None


def is_omp(cmd):
    """An omp agent process, not one of its workers or a broker."""
    return re.match(r"(\S*/)?omp(\s|$)", cmd) is not None and "__omp_worker" not in cmd and not is_broker(cmd)


def job_groups(procs):
    """Job groups by CPU, highest first: [{"pid": root, "cpu": %}]. A container (the kernel, launchd, an omp, a broker)
    is a group by itself; any other process belongs to its ancestor just below the nearest container: an omp's
    tool command with everything it started, or launchd's child (an app, a daemon, a detached job) with its own."""
    def container(p):
        return p["pid"] in (0, 1) or is_omp(p["cmd"]) or is_broker(p["cmd"])
    roots = {}
    for start in procs:
        chain, pid = [], start
        while pid not in roots:
            p = procs[pid]
            chain.append(pid)
            parent = procs.get(p["ppid"])
            if container(p) or parent is None or container(parent) or len(chain) > 64:
                roots[pid] = pid
                break
            pid = parent["pid"]
        roots.update((c, roots[pid]) for c in chain)
    groups = {}
    for pid, p in procs.items():
        groups.setdefault(roots[pid], {"pid": roots[pid], "cpu": 0.0})["cpu"] += p["cpu"]
    return sorted(groups.values(), key=lambda g: -g["cpu"])


def proc_env(pid):
    """pid's command line followed by its environment (`ps eww`)."""
    args = ["ps", "eww", "-o", "command=", "-p", str(pid)]
    return run(["sudo", "-n", *args], timeout=10) or run(args, timeout=10)


def env_owner(pid):
    """(kind, id, via) from pid's EASL_TILE_ID (an easl tile) or HERDR_PANE_ID (a herdr pane), else None."""
    env = proc_env(pid)
    for kind, var in (("tile", "EASL_TILE_ID"), ("pane", "HERDR_PANE_ID")):
        found = re.findall(r"(?:^|\s)%s=(\S+)" % var, env)
        if found:
            return kind, found[-1], var
    return None


def omp_owner(omp, procs):
    """(kind, id, via) for the agent an omp process is: the easl tile the zmx server above it is labelled with, else
    its EASL_TILE_ID or HERDR_PANE_ID; None when nothing names it."""
    q = procs.get(omp["ppid"])
    for _ in range(64):
        if q is None or q["pid"] <= 1:
            break
        m = re.search(r"\bcanvas\.tile=(obj_\w+)", q["cmd"])
        if m:
            return "tile", m.group(1), "zmx label"
        q = procs.get(q["ppid"])
    return env_owner(omp["pid"])


@functools.lru_cache(maxsize=None)
def herdr_panes():
    """{pane id: agent name} from `herdr agent list`, once per run; {} when herdr does not answer."""
    try:
        agents = json.loads(run([os.path.join(BIN, "herdr"), "agent", "list"], timeout=20))["result"]["agents"]
        return {a["pane_id"]: a.get("name") for a in agents}
    except (ValueError, KeyError, TypeError):
        return {}


def owner_tile(owner):
    return next((t for t in easl_tiles() if t["tile"] == owner[1]), None) if owner[0] == "tile" else None


def owner_name(owner):
    """The agent's name (easl tile name, herdr agent name), else its tile or pane id."""
    name = (owner_tile(owner) or {}).get("name") if owner[0] == "tile" else herdr_panes().get(owner[1])
    return name or owner[1]


def owner_label(owner):
    """The agent's name and id, "name (id)", or the id alone for an agent without a name."""
    return owner[1] if owner_name(owner) == owner[1] else f"{owner_name(owner)} ({owner[1]})"


def verdict(g, procs):
    """(owner, None) when an agent owns job group g, else (None, why it is not messaged about)."""
    p = procs[g["pid"]]
    parent = procs.get(p["ppid"])
    if is_omp(p["cmd"]):
        o = omp_owner(p, procs)
        return None, "omp runtime of " + (owner_name(o) if o else "an unknown agent")
    path = exe_path(p["cmd"])
    if is_broker(p["cmd"]):
        return None, "broker"
    if os.path.basename(path) == "zmx":
        return None, "zmx"
    if any(app in path.lower() for app in TIM_APPS):
        return None, "Tim's app"
    if p["pid"] in (0, 1) or os.path.basename(path) in ("kernel_task", "WindowServer") or path.startswith(SYSTEM_PATHS):
        return None, "system"
    if parent is not None and is_omp(parent["cmd"]):
        o, unknown = omp_owner(parent, procs), f"under omp {parent['pid']}, whose agent is unknown"
    elif parent is not None and is_broker(parent["cmd"]):
        return None, "under a shared omp broker; owner unknown"  # its parent omp only started the broker
    elif p["user"] != ME:
        return None, "system"
    else:
        o, unknown = env_owner(p["pid"]), "no agent owner"  # a detached job keeps its agent's environment
        o = o and (o[0], o[1], "the job's " + o[2])
    if o is None:
        return None, unknown
    return (None, "Tim's own session") if tims_session(o) else (o, None)


def tims_session(owner):
    """Tim's own tile: one with no agent name (his ad-hoc session; his tiktok tile was home's top consumer on 10-07) or
    the one he has focused (his call). Never told to stop."""
    t = owner_tile(owner)
    return t is not None and (not t.get("name") or t.get("focused") is True)


def send_owner(owner, text):
    """Message an owner: an omp easl tile with a protocol through agent.prompt, a herdr pane through agent-msg."""
    if owner[0] == "pane":
        return pane_prompt(owner[1], text)
    t = owner_tile(owner)
    return t is not None and t.get("kind") == "omp" and type(t.get(TILE_PROTOCOL)) is int and tile_prompt(t, text)


def owner_message(host, idle, streak, jobs, procs):
    one = len(jobs) == 1
    it = "it" if one else "them"
    listed = "; ".join(f"pid {g['pid']} `{short_cmd(procs[g['pid']]['cmd'])[:80]}` at {g['cpu']:.0f}% CPU "
                       f"with its children (#{g['rank']})" for g in jobs)
    return (f"[machine-watch {host}] Tim is typing and this Mac's CPU is saturated (idle {idle:.0f}% on {streak} "
            f"checks a minute apart); his keys and clicks break system-wide while it is. "
            f"Your {'job is one' if one else 'jobs are'} of the top CPU consumers: {listed}. Stop {it} now. "
            f"Then rerun {it} as `machine-ok-queue run -- <command>` (it waits for a free slot and clamps the job's "
            f"priority) or `offload -- <command>` (it runs on deckbox), and cap {'its' if one else 'their'} parallelism.")


def saturation_act(state, now, host, idle, streak, dry):
    """Message the owners of the top 3 CPU consumers and tell the shepherd whom; returns the fast log's fields."""
    procs = consumers()
    top = job_groups(procs)[:3]
    owners, untold = {}, []
    for rank, g in enumerate(top, 1):
        g["rank"] = rank
        owner, why = verdict(g, procs)
        if owner and g["cpu"] < OWNER_MIN_CPU:
            owner, why = None, f"owner {owner_name(owner)}; under {OWNER_MIN_CPU:.0f}%"
        g["owner"], g["why"] = owner and owner[1], why
        if owner:
            owners.setdefault(owner[:2], []).append(g)  # one message per agent, however its jobs map to it
        else:
            untold.append(g)
        if dry:
            if owner:
                where = f"{'easl tile' if owner[0] == 'tile' else 'herdr pane'} {owner[1]} by {owner[2]}"
                who = f"{owner_name(owner)} ({where})" if owner_name(owner) != owner[1] else where
            else:
                who = f"not messaged ({why})"
            print(f"#{rank} {g['cpu']:4.0f}%  pid {g['pid']:<6} {short_cmd(procs[g['pid']]['cmd'])[:60]}  -> {who}")
    sent = {k: t for k, t in state.get("owner_alert", {}).items() if now - t < OWNER_COOLDOWN_S}
    told = []
    for owner, jobs in owners.items():
        key = lambda g: f"{owner[1]}|{exe_name(procs[g['pid']]['cmd'])}"
        fresh = [g for g in jobs if key(g) not in sent]
        for g in jobs:
            if g not in fresh:
                g["why"] = f"{owner_name(owner)} told in the last 10 min"
                untold.append(g)
        if not fresh:
            continue
        text = owner_message(host, idle, streak, fresh, procs)
        if dry:
            print(f"OWNER ALERT -> {owner_label(owner)} : {text}")
        elif not send_owner(owner, text):
            for g in fresh:
                g["why"] = f"{owner_label(owner)} unreachable"
                untold.append(g)
            continue
        told.append((owner, fresh))
        sent.update((key(g), now) for g in fresh)
    state["owner_alert"] = sent
    untold.sort(key=lambda g: g["rank"])
    job = lambda g: f"pid {g['pid']} {exe_name(procs[g['pid']]['cmd'])} at {g['cpu']:.0f}%"
    line = (f"[machine-watch {host}] CPU saturated while Tim is active (idle {idle:.0f}% on {streak} checks a minute "
            "apart). " + ("Messaged " + "; ".join(f"{owner_label(o)} about " + ", ".join(map(job, jobs))
                                                  for o, jobs in told) + "." if told else "Messaged no agent.")
            + (" Not messaged: " + "; ".join(f"{job(g)} ({g['why']})" for g in untold) + "." if untold else ""))
    # The shepherd hears each time an agent is messaged, otherwise hourly.
    if told or now - state["last_alert"].get("cpu_fast", 0) >= COOLDOWN_S:
        deliver(line, "CPU saturated while Tim is active", False, dry)
        state["last_alert"]["cpu_fast"] = now
    return {"top": [{"pid": g["pid"], "cpu": round(g["cpu"]), "exe": exe_name(procs[g["pid"]]["cmd"]),
                     "owner": g["owner"], "why": g["why"]} for g in top],
            "messaged": [o[1] for o, _ in told]}


def fast_check(state, now, hid, host, dry, no_alert):
    """One active-time check: a CPU sample, the run of saturated checks it extends or ends, and on the FAST_STREAK-th
    saturated check in a row (or later), saturation_act. Returns its fast log record."""
    idle = cpu_idle_sample()
    last = state.get("fast") or {}
    hit = idle is not None and idle < FAST_IDLE_PCT
    streak = (last.get("streak", 0) if now - last.get("at", 0) <= FAST_GAP_S else 0) + 1 if hit else 0
    state["fast"] = {"streak": streak, "at": now}
    rec = {"ts": now, "hid_idle_s": round(hid, 1), "cpu_idle": idle, "streak": streak}
    if streak >= FAST_STREAK and not no_alert:
        rec.update(saturation_act(state, now, host, idle, streak, dry))
    return rec


def relay(state, now, dry):
    """Forward queued alerts from remote machines and flag a remote whose watcher went quiet."""
    try:
        with open(REMOTES) as f:
            hosts = [h.strip() for h in f if h.strip() and not h.startswith("#")]
    except OSError:
        return
    seen = state.setdefault("remote_seen", {})
    # Newest watcher record successfully read per host. Staleness is judged against it,
    # so one failed ssh attempt (a network blip) is not reported as an outage; a remote
    # that stays unreachable still alerts once its last good record is 10 minutes old.
    records = state.setdefault("remote_last_record", {})
    for host in hosts:
        out = run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", host,
                   "cat ~/.local/state/machine-watch.alerts 2>/dev/null; echo ---LAST---; "
                   "tail -1 ~/.local/state/machine-watch.jsonl 2>/dev/null"], timeout=40)
        queued, _, last = out.partition("---LAST---")
        for line in queued.splitlines():
            try:
                alert = json.loads(line)
            except json.JSONDecodeError:
                continue
            if alert["ts"] > seen.get(host, now - 3600):
                deliver(alert["text"], alert["text"][:120], False, dry)
                seen[host] = max(seen.get(host, 0), alert["ts"])
        seen.setdefault(host, now)
        try:
            records[host] = json.loads(last.strip())["ts"]
        except (json.JSONDecodeError, KeyError):
            pass
        last_ts = records.get(host, 0)
        key = "remote_stale:" + host
        if now - last_ts > 600 and now - state["last_alert"].get(key, 0) >= COOLDOWN_S:
            why = "unreachable over ssh" if not out else f"last record {(now - last_ts) // 60} min old" if last_ts else "no records"
            deliver(f"[machine-watch relay] {host} watcher is not reporting ({why}); its pressure alerts are not reaching you.",
                    f"{host} watcher silent", False, dry)
            if not dry:
                state["last_alert"][key] = now


# Runs on the client (python3 stdin). Prints no secret: the token only goes into a header.
# /v1/healthz is public; on the authenticated route a rejected token gets 401, an accepted
# one reaches routing (404: the route needs parameters), so anything but 401/0 = accepted.
BROKER_PROBE = r'''
import json, os, re, urllib.request, urllib.error
url, inside = None, False
for line in open(os.path.expanduser("~/.omp/agent/config.yml")):
    if re.match(r'\s*"?broker"?\s*:\s*$', line):
        inside = True
    elif inside:
        m = re.match(r'\s*"?url"?\s*:\s*"?([^"\s]+)"?\s*$', line)
        if m:
            url = m.group(1)
            break
def get(path, token=None):
    req = urllib.request.Request(url.rstrip("/") + path, headers={"Authorization": "Bearer " + token} if token else {})
    try:
        with urllib.request.urlopen(req, timeout=8) as r:
            return r.status, r.read(300).decode(errors="replace")
    except urllib.error.HTTPError as e:
        return e.code, ""
    except Exception as e:
        return 0, type(e).__name__
out = {"url": url}
if url:
    out["health"], body = get("/v1/healthz")
    try:
        out["ok"], out["version"] = json.loads(body).get("ok"), json.loads(body).get("version")
    except ValueError:
        out["error"] = body[:60]
    try:
        token = open(os.path.expanduser("~/.omp/auth-broker.token")).read().strip()
    except OSError:
        token = None
    out["auth"] = get("/v1/credentials/check", token)[0] if token else "no token"
print("BROKER " + json.dumps(out))
'''


def broker_clients(state, now, dry, no_alert):
    """Check each broker-mode client's path to this machine's auth broker (see docstring)."""
    try:
        with open(BROKER_CLIENTS) as f:
            hosts = [h.strip() for h in f if h.strip() and not h.startswith("#")]
    except OSError:
        return None
    bs = state.setdefault("broker_clients", {})
    results = {}
    for host in hosts:
        s = bs.setdefault(host, {"checked": 0, "last_good": now, "alerted": False})
        if now - s["checked"] < BROKER_EVERY_S:
            continue
        try:
            r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", host, "python3 -"],
                               input=BROKER_PROBE, capture_output=True, text=True, timeout=40)
            line = next((l for l in r.stdout.splitlines() if l.startswith("BROKER ")), None)
            res = json.loads(line[7:]) if line else {"error": "ssh failed: " + (r.stderr.strip()[-80:] or f"rc {r.returncode}")}
        except (subprocess.SubprocessError, ValueError) as e:
            res = {"error": f"probe failed: {type(e).__name__}"}
        good = res.get("health") == 200 and res.get("ok") is True and res.get("auth") not in (401, 0, "no token")
        res["good"] = good
        results[host] = res
        s["checked"] = now
        if good:
            if s.get("alerted") and not no_alert:
                deliver(f"[machine-watch broker] {host} reaches the auth broker again ({res.get('url')}, v{res.get('version')}).",
                        f"{host} broker recovered", False, dry)
            s.update(last_good=now, alerted=False)
            continue
        down = now - s["last_good"]
        if down >= BROKER_ALERT_S and not no_alert and now - state["last_alert"].get("broker:" + host, 0) >= COOLDOWN_S:
            deliver(f"[machine-watch broker] {host} cannot use the auth broker for {down // 60} min: {json.dumps(res)}. "
                    f"Its omp loses all credentials ~1 h after the broker became unreachable (snapshot cache TTL). "
                    f"Check com.twaldin.omp-auth-broker on this machine (bind address, health) and the tailnet path.",
                    f"{host} auth broker unreachable", down >= 2400, dry)
            if not dry:
                state["last_alert"]["broker:" + host] = now
                s["alerted"] = True
    return results or None


# Runs on a patched Linux host (python3 stdin; argv: units that must be active). Reads only.
PATCH_PROBE = r'''
import glob, json, os, subprocess, sys, time
def age_h(paths):
    ts = [os.stat(p).st_mtime for p in paths if os.path.exists(p)]
    return round((time.time() - max(ts)) / 3600, 1) if ts else None
out = {"kernel": os.uname().release, "up_d": round(float(open("/proc/uptime").read().split()[0]) / 86400, 1),
       "reboot_h": age_h(["/var/run/reboot-required"]),
       "lists_h": age_h(glob.glob("/var/lib/apt/lists/*InRelease")),
       "uu_h": age_h(["/var/lib/apt/periodic/unattended-upgrades-stamp"])}
try:
    out["reboot_pkgs"] = sorted(set(open("/var/run/reboot-required.pkgs").read().split()))
except OSError:
    out["reboot_pkgs"] = []
lines = [l for l in subprocess.run(["apt", "list", "--upgradable"], capture_output=True, text=True,
                                   timeout=120).stdout.splitlines() if "/" in l]
out["upgradable"], out["security"] = len(lines), sum("-security" in l for l in lines)
units = sys.argv[1:]
states = subprocess.run(["systemctl", "is-active", *units], capture_output=True, text=True).stdout.split() if units else []
out["down"] = [u for u, s in zip(units, states) if s != "active"] + units[len(states):]
print("PATCH " + json.dumps(out))
'''


def patch_status(host, r):
    """One line on a host's patch state, with what needs the shepherd first."""
    if "error" in r:
        return f"[machine-watch patch] {host}: patch probe failed ({r['error']})."
    head = [f"NOT ACTIVE: {', '.join(r['down'])}"] if r["down"] else []
    if r["lists_h"] is None or r["lists_h"] > PATCH_STALE_H:
        head.append(f"package lists {'missing' if r['lists_h'] is None else '%.0f h old' % r['lists_h']}: apt-daily stopped?")
    if r["uu_h"] is not None and r["uu_h"] > PATCH_STALE_H:
        head.append(f"unattended-upgrades last ran {r['uu_h']:.0f} h ago")
    if r["reboot_h"] is not None:
        pkgs = ", ".join(r["reboot_pkgs"][:6]) + (" …" if len(r["reboot_pkgs"]) > 6 else "")
        reboot = f"reboot required for {r['reboot_h']:.0f} h ({pkgs or 'no package list'})"
        reboot += "; monthly window overdue" if r["up_d"] > 35 else ""
    else:
        reboot = "no reboot required"
    tail = [f"kernel {r['kernel']}, up {r['up_d']:.0f} d", reboot,
            f"{r['upgradable']} upgradable ({r['security']} security) for the monthly window",
            "unattended-upgrades " + ("not yet run by its timer" if r["uu_h"] is None else f"ran {r['uu_h']:.0f} h ago")]
    return f"[machine-watch patch] {host}: " + "; ".join(head + tail) + "."


def patch_watch(state, now, dry, no_alert):
    """Probe each patch host every PATCH_EVERY_S (see the docstring); None when there are none or none was due."""
    try:
        with open(PATCH_HOSTS) as f:
            hosts = [line.split() for line in f if line.strip() and not line.startswith("#")]
    except OSError:
        return None
    ps = state.setdefault("patch", {})
    results = {}
    for host, *units in hosts:
        s = ps.setdefault(host, {"checked": 0, "reported": 0})
        if now - s["checked"] < PATCH_EVERY_S:
            continue
        s["checked"] = now
        try:
            r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", host,
                                " ".join(["python3", "-"] + [shlex.quote(u) for u in units])],
                               input=PATCH_PROBE, capture_output=True, text=True, timeout=180)
            line = next((l for l in r.stdout.splitlines() if l.startswith("PATCH ")), None)
            res = json.loads(line[6:]) if line else {"error": "ssh failed: " + (r.stderr.strip()[-80:] or f"rc {r.returncode}")}
        except (subprocess.SubprocessError, ValueError) as e:
            res = {"error": f"probe failed: {type(e).__name__}"}
        results[host] = res
        down = res.get("down") or []
        alarm = bool(down) and now - state["last_alert"].get("patch:" + host, 0) >= COOLDOWN_S
        if no_alert or not (alarm or now - s["reported"] >= PATCH_REPORT_S):
            continue
        deliver(patch_status(host, res), f"{host}: " + ("units down: " + ", ".join(down) if down else "patch status"),
                bool(down), dry)
        if not dry:
            s["reported"] = now
            if down:
                state["last_alert"]["patch:" + host] = now
    return results or None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--tick", action="store_true",
                    help="launchd's minute tick: the full watch only when the last one is ~2 min old; the fast "
                         "check whenever Tim is active")
    ap.add_argument("--dry-run", action="store_true", help="print alerts instead of sending; do not update alert state")
    ap.add_argument("--no-alert", action="store_true")
    ap.add_argument("--consumers", action="store_true",
                    help="print the top CPU consumers, their owners and the messages the fast rule would send; send nothing")
    ap.add_argument("--ack-colorsync", action="store_true",
                    help="record the current WindowServer's ColorSync level as known; colorsync_ratchet then fires only on a further rise")
    a = ap.parse_args()
    os.makedirs(STATE_DIR, exist_ok=True)
    if a.ack_colorsync:
        ws = windowserver_pid()
        cs = colorsync_rate()
        if ws is None or cs is None:
            print("colorsync_ratchet: cannot measure WindowServer or ColorSync now; nothing acknowledged")
            return 1
        state = load_state()
        state.pop("cs_ack_ws", None)
        state["cs_ack"] = {"ws": ws, "profiles_ps": cs["profiles_ps"]}
        save_state(state)
        print(f"colorsync_ratchet: acknowledged {cs['profiles_ps']}/s on WindowServer pid {ws}; alerts again above {cs['profiles_ps'] + 3:.1f}/s")
        return 0

    now = int(time.time())
    host = os.uname().nodename.split(".")[0]
    if a.consumers:
        idle = cpu_idle_sample()
        saturation_act({"last_alert": {}}, now, host, 100.0 if idle is None else idle, FAST_STREAK, True)
        return 0
    hid = hid_idle_s()
    active = hid is not None and hid < ACTIVE_S
    state = load_state()
    since_full = now - state.get("full_at", 0)
    fast = None
    if active:
        fast = fast_check(state, now, hid, host, a.dry_run, a.no_alert)
        append_log(fast, FAST_LOG)
    else:
        ended = bool((state.get("fast") or {}).get("streak"))
        state["fast"] = {"streak": 0, "at": now}  # an idle minute ends a run of saturated active-time checks
        if a.tick and since_full < FULL_EVERY_S:
            if ended and not a.dry_run:
                save_state(state)
            return 0
    # While Tim types on a saturated CPU the full run (census, log show, ssh) waits, up to FULL_DEFER_S: under load
    # it ran up to 2 min, and launchd skips the ticks that fall inside a run.
    deferred = fast is not None and fast["streak"] > 0 and since_full < FULL_DEFER_S
    if a.tick and (since_full < FULL_EVERY_S or deferred):
        if not a.dry_run:
            save_state(state)
        if fast["streak"]:
            print(time.strftime("%F %T"), "fast", f"cpu_idle={fast['cpu_idle']}% streak={fast['streak']}",
                  "messaged=" + (",".join(fast.get("messaged", [])) or "none")
                  + (" full run deferred" if since_full >= FULL_EVERY_S else ""))
        return 0

    os.nice(10)  # the full run yields to everything else, as launchd's Nice 10 had it before the minute ticks
    ws = windowserver_pid()
    try:
        census = json.loads(run([os.path.join(BIN, "machine-census"), "--json", "--sample", "2"], timeout=120))
    except json.JSONDecodeError:
        print(time.strftime("%F %T"), "census failed")
        if not a.dry_run:
            save_state(state)  # the fast check's streak and cooldowns
        return 1
    fs = fsevents()
    cs = colorsync_rate()
    state["full_at"] = now
    v, fire = evaluate(census, fs, state, now, cs, ws, active)
    broker = broker_clients(state, now, a.dry_run, a.no_alert)
    patch = patch_watch(state, now, a.dry_run, a.no_alert)
    append_log({"ts": now, "values": v, "memory": census["memory"], "groups": census["groups"],
                "agents": [{k: r[k] for k in ("pid", "pane", "mem_mb", "cpu", "session_mb", "project")} for r in census["agents"]],
                "fsevents": fs, "colorsync": cs, "fired": fire, **({"broker_clients": broker} if broker else {}),
                **({"patch": patch} if patch else {})})
    if fire and not a.no_alert:
        if "omp_spin" in fire:
            v["spin_status"], v["spin_sys"] = spin_detail(v["spin_pid"], v["spin_pane"])
        notify(census, fs, v, fire, a.dry_run)
        if not a.dry_run:
            for r in fire:
                state["last_alert"][r] = now
    if not a.no_alert:
        relay(state, now, a.dry_run)
    if not a.dry_run:
        save_state(state)
    print(time.strftime("%F %T"), "ok", "fired=" + (",".join(fire) or "none"),
          f"free={v['free_pct']}% fseventsd={v['fseventsd_mb']}MB fsev={v['fsevents_rate']:.0f}/s ws={v['windowserver_cpu']}%")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
