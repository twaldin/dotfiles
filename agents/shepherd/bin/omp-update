#!/usr/bin/env python3
"""Update omp and resume idle easl leads, without messages or fresh sessions.

The newest release published on both GitHub and npm for at least 3 hours wins,
excluding blocked_versions; hosts may hold_below a version. Install in canary
order deckbox -> work -> home, never downgrade, and restart older launchd omp
services. Remote hosts run this same script over ssh.

Named easl omp tiles resume in place only for an older binary or RSS > 1.5 GB.
Never touch Tim's unnamed tiles or report_only names (including lindy-seat).
Working/blocked, closed boards, restored lifecycle, unseen/unknown done, focus or
draft unknown/present, child work and in-process subagents prevent a restart.
Recheck immediately before acting; non-forced easl conflicts (including pending
prompts/messages) are skips. Require a session on disk and omp on easl's zsh PATH.
Within 60 seconds verify the same session, a new pid, protocol >= 1 and model.
Errors are logged, end that host and make the run exit nonzero; other hosts
continue unless a target install or observed resume verification fails. Only
protocol/model failures can block a version later hosts lack. No messages are sent.

Config: ~/.config/omp-update/config.json; local easl opt-in:
~/.config/machine-shepherd/easl.json {"enabled": true, "cli": ".../bin/easl"}.
Logs: ~/.local/state/omp-update/actions.jsonl and last-run.json.
Usage: omp-update run [--dry-run] [--hosts deckbox,work,home]
       omp-update target
"""
import argparse
import copy
import datetime as dt
import fcntl
import glob
import hashlib
import json
import os
import platform
import re
import shlex
import subprocess
import sys
import time

REPO = "can1357/oh-my-pi"
NPM_PKG = "@oh-my-pi/pi-coding-agent"
HOME = os.path.expanduser("~")
BUN_BIN = os.path.join(HOME, ".bun", "bin")
OMP = os.path.join(BUN_BIN, "omp")
STATE = os.path.join(HOME, ".local", "state", "omp-update")
CONFIG = os.path.join(HOME, ".config", "omp-update", "config.json")
EASL_SWITCH = os.path.join(HOME, ".config", "machine-shepherd", "easl.json")
ENV = dict(os.environ, PATH=os.pathsep.join([
    BUN_BIN, os.path.join(HOME, ".local", "bin"), "/opt/homebrew/bin", "/usr/local/bin",
    "/usr/bin", "/bin", "/usr/sbin", "/sbin"]))
MAC = platform.system() == "Darwin"
ORDER = ("deckbox", "work", "home")
MAX_RSS_MB = 1536
VERIFY_S = 60
SUBAGENT_FRESH_S = 180
DEFAULT_CONFIG = {
    "hosts": {
        "deckbox": {"ssh": "tim@deckbox", "python": "python3"},
        "work": {"ssh": "twaldin-work", "python": "/usr/bin/python3",
                 "easl": "/Applications/easl.app/Contents/Resources/bin/easl"},
        "home": {"ssh": None, "services": [
            {"label": "com.twaldin.omp-auth-broker", "match": "auth-broker serve",
             "health": "http://twaldin-home:8765/v1/healthz"},
            {"label": "com.twaldin.omp-auth-gateway", "match": "auth-gateway serve",
             "health": "http://twaldin-home:4000/healthz"}]},
    },
    "min_age_hours": 3,
    "report_only": {"names": ["lindy-seat"]},
    "blocked_versions": {},
}
HOST_KEYS = ("ssh", "python", "easl", "services", "hold_below", "hold_note")
# Look through omp's workers/kernels for child work; ignore browser/LSP subtrees.
TRANSPARENT = re.compile(r"__omp_worker_|/omp-python-runner(-\d+)?/")
SUBTREE_OK = re.compile(r"/\.omp/puppeteer/|pyright|langserver|language-server|languageserver|"
                        r"tsserver|rust-analyzer|gopls|clangd|sourcekit-lsp|lsp-mux|biome lsp|ruff server")


def sh(cmd, timeout=120, check=False, **kw):
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=ENV, **kw)
    if check and r.returncode != 0:
        raise RuntimeError(f"{os.path.basename(cmd[0])} failed ({r.returncode}): "
                           f"{(r.stderr or r.stdout).strip()[:300]}")
    return r


def vtuple(v):
    return tuple(int(x) for x in re.findall(r"\d+", v or "")[:3])


def utcnow():
    return dt.datetime.now(dt.timezone.utc)


def parse_ts(s):
    return dt.datetime.fromisoformat(s.replace("Z", "+00:00"))


def stamp():
    return utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")


def omp_version(path=OMP):
    out = sh([path, "--version"], timeout=60, check=True).stdout
    m = re.search(r"omp/(\S+)", out)
    if not m:
        raise RuntimeError(f"{path} --version did not report an omp version")
    return m.group(1)


def install_time():
    real = os.path.realpath(OMP)
    if real.endswith(".js"):
        real = os.path.join(os.path.dirname(os.path.dirname(real)), "package.json")
    return os.stat(real).st_mtime


def stage_binary(target):
    """Download, checksum and execute the release binary before swapping it in."""
    arch = "arm64" if platform.machine().lower() in ("arm64", "aarch64") else "x64"
    asset = f"omp-{platform.system().lower()}-{arch}"
    base = f"https://github.com/{REPO}/releases/download/v{target}/"
    sums = sh(["curl", "-fsSL", "--retry", "3", base + "SHA256SUMS.txt"], check=True).stdout
    want = next((ln.split()[0] for ln in sums.splitlines()
                 if len(ln.split()) == 2 and ln.split()[1].lstrip("*") == asset), None)
    if not want:
        raise RuntimeError(f"{asset} missing from SHA256SUMS.txt of v{target}")
    tmp = os.path.join(BUN_BIN, f".omp-update-{target}-{os.getpid()}")
    try:
        sh(["curl", "-fsSL", "--retry", "3", "-o", tmp, base + asset], timeout=1200, check=True)
        h = hashlib.sha256()
        with open(tmp, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
        if h.hexdigest() != want:
            raise RuntimeError(f"sha256 mismatch for {asset}")
        os.chmod(tmp, 0o755)
        got = omp_version(tmp)
        if got != target:
            raise RuntimeError(f"staged {asset} reports {got}, expected {target}")
        return tmp
    except Exception:
        if os.path.exists(tmp):
            os.remove(tmp)
        raise


def flock_wait(lock, seconds):
    deadline = time.time() + seconds
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return
        except BlockingIOError:
            if time.time() >= deadline:
                raise RuntimeError(f"{os.path.basename(lock.name)} held for {seconds} s")
            time.sleep(min(5, deadline - time.time()))


def swap_binary(tmp):
    """Retain the old mapped binary under omp's own backup naming convention."""
    with open(os.path.join(BUN_BIN, "omp.lock"), "a") as lk:
        flock_wait(lk, 120)
        bak = os.path.join(BUN_BIN, f"omp.{int(time.time() * 1000)}.{os.getpid()}.0.bak")
        os.rename(OMP, bak)
        try:
            os.rename(tmp, OMP)
        except OSError:
            os.rename(bak, OMP)
            raise
    return bak


def prune_baks(dry):
    """Keep the newest backup and any mapped binary; uncertain lsof results are fatal."""
    acts = []
    baks = sorted(glob.glob(os.path.join(BUN_BIN, "omp.*.bak")), key=os.path.getmtime, reverse=True)
    for path in baks[1:]:
        r = sh(["lsof", "-t", "--", path], timeout=60)
        if r.returncode not in (0, 1) or (r.returncode == 1 and r.stderr.strip()):
            raise RuntimeError(f"lsof failed for {path}: {r.stderr.strip()[:200]}")
        if r.stdout.split():
            continue
        acts.append({"kind": "prune-bak", "file": os.path.basename(path), "dry_run": dry})
        if not dry:
            os.remove(path)
    return acts


def etime_s(s):
    days, _, rest = s.strip().rpartition("-")
    parts = [int(x) for x in rest.split(":")]
    parts = [0] * (3 - len(parts)) + parts
    return (int(days) if days else 0) * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2]


def ps_table():
    cmd = ["ps", "-axo", "pid=,ppid=,etime=,rss=,command="] if MAC else ["ps", "-eo", "pid=,ppid=,etime=,rss=,args="]
    procs = {}
    for ln in sh(cmd, timeout=60, check=True).stdout.splitlines():
        p = ln.split(None, 4)
        if len(p) == 5:
            procs[int(p[0])] = {"ppid": int(p[1]), "age_s": etime_s(p[2]), "rss_mb": int(p[3]) / 1024, "cmd": p[4]}
    return procs


def is_agent_omp(cmd):
    argv = cmd.split()
    if not argv:
        return False
    if os.path.basename(argv[0]) == "omp":
        rest = argv[1:]
    elif os.path.basename(argv[0]) in ("bun", "node") and len(argv) > 1 and (
            argv[1].endswith("/.bun/bin/omp") or argv[1].endswith("pi-coding-agent/dist/cli.js")):
        rest = argv[2:]
    else:
        return False
    return not (rest and rest[0].startswith("__omp_"))


def mem_mb(pid):
    try:
        val = sh(["top", "-l", "1", "-pid", str(pid), "-stats", "mem"], timeout=30).stdout.split()[-1]
        m = re.match(r"([\d.]+)([BKMGT])", val.upper())
        return round(float(m[1]) * {"B": 1 / 1048576, "K": 1 / 1024, "M": 1, "G": 1024, "T": 1048576}[m[2]]) if m else None
    except (OSError, ValueError, IndexError, subprocess.TimeoutExpired):
        return None


def exe_path(pid):
    out = sh(["lsof", "-a", "-p", str(pid), "-d", "txt", "-Fn"], timeout=60, check=True).stdout
    return next((ln[1:] for ln in out.splitlines() if ln.startswith("n") and "/.bun/bin/omp" in ln), None)


def running_version(pid, age_s, installed):
    path = exe_path(pid)
    if path and path != OMP:
        v = omp_version(path)
        return vtuple(v) < vtuple(installed), v
    older = time.time() - age_s < install_time() - 60
    return older, None if older else installed


def open_sessions(pid):
    out = sh(["lsof", "-a", "-p", str(pid), "-Fn"], timeout=60, check=True).stdout
    return sorted({ln[1:] for ln in out.splitlines()
                   if ln.startswith("n") and "/.omp/agent/sessions/" in ln and ln.endswith(".jsonl")})


def live_children(pid, procs):
    kids = {}
    for p, info in procs.items():
        kids.setdefault(info["ppid"], []).append(p)
    found, stack = [], list(kids.get(pid, []))
    while stack:
        c = stack.pop()
        cmd = procs[c]["cmd"]
        if SUBTREE_OK.search(cmd):
            continue
        if not TRANSPARENT.search(cmd):
            found.append(f"{c} {cmd[:70]}")
        stack.extend(kids.get(c, []))
    return found


def running_subagents(pid, session):
    folder = session[:-6] + os.sep
    found = {p for p in open_sessions(pid) if os.path.isfile(os.path.dirname(p) + ".jsonl")}
    for p in glob.glob(os.path.join(glob.escape(folder), "**", "*.jsonl"), recursive=True):
        try:
            if os.path.getmtime(p) >= time.time() - SUBAGENT_FRESH_S:
                found.add(p)
        except OSError:
            pass
    return [f"subagent {p[len(folder):-6] if p.startswith(folder) else os.path.basename(p)[:-6]}" for p in sorted(found)]


def ancestors(procs):
    out, p = set(), os.getpid()
    while p in procs and p > 1:
        out.add(p)
        p = procs[p]["ppid"]
    return out


def easl_switch():
    try:
        with open(EASL_SWITCH) as f:
            s = json.load(f)
        return s if isinstance(s, dict) and s.get("enabled") is True and s.get("cli") else None
    except (OSError, ValueError):
        return None


def host_easl(hc):
    if not hc.get("ssh"):
        return easl_switch()
    return {"cli": hc["easl"]} if hc.get("easl") else None


class EaslConflict(RuntimeError):
    pass


def easl(cli, *args, timeout=60):
    r = sh([cli, *args], timeout=timeout)
    try:
        out = json.loads(r.stdout)
    except ValueError:
        out = None
    if r.returncode or not isinstance(out, dict) or out.get("error"):
        detail = (r.stderr or r.stdout).strip()[:300] or f"exit {r.returncode}"
        error = EaslConflict if re.search(r"\bconflict\b", detail) else RuntimeError
        raise error(f"easl {args[0]}: {detail}")
    return out


def tile_agents(cli, timeout=60):
    return [dict(t, cli=cli) for t in easl(cli, "agent.list", timeout=timeout)["agents"] if t.get("kind") == "omp"]


def tile_get(cli, tile, timeout=60):
    return next((t for t in tile_agents(cli, timeout=timeout) if t["tile"] == tile), None)


def tile_session(cli, tile, timeout=60):
    o = easl(cli, "object.get", "--id", tile, timeout=timeout)
    return (((o.get("object") or {}).get("props") or {}).get("agent") or {}).get("sessionPath")


def easl_finds_omp(cli, procs):
    """Check the app's zsh environment, not this launchd job's augmented PATH."""
    app = cli.split("/Contents/")[0] + "/Contents/MacOS/"
    env = {"HOME": HOME, "PATH": "/usr/bin:/bin:/usr/sbin:/sbin"}
    pid = next((p for p, i in procs.items() if i["cmd"].startswith(app)), None)
    if pid:
        for tok in sh(["/bin/ps", "-E", "-ww", "-o", "command=", "-p", str(pid)], timeout=30).stdout.split():
            key, eq, val = tok.partition("=")
            if eq and key in env:
                env[key] = val
    r = sh(["/usr/bin/env", "-i", f"HOME={env['HOME']}", f"PATH={env['PATH']}", "SHELL=/bin/zsh",
            "/bin/zsh", "-c", "command -v omp"], timeout=30)
    found = (r.stdout.strip().splitlines() or [""])[-1]
    if r.returncode != 0 or not found.startswith("/"):
        raise RuntimeError("easl's zsh finds no omp; tile restarts held")


def idle_gate(a, procs, session):
    if a.get("open") is not True:
        return "board closed or unknown"
    lc = a.get("lifecycle") or {}
    if lc.get("restored"):
        return "lifecycle restored after an app restart, unconfirmed"
    if lc.get("state") not in ("idle", "done"):
        return str(lc.get("state") or "unknown")
    if lc["state"] == "done" and lc.get("seen") is not True:
        return "done, answer not seen by Tim"
    for key in ("focused", "draft"):
        if a.get(key) is not False:
            return f"{key} present or unknown"
    if a["pid"] not in procs or not is_agent_omp(procs[a["pid"]]["cmd"]):
        return "omp process not confirmed"
    if a["pid"] in ancestors(procs):
        return "runs this job"
    busy = live_children(a["pid"], procs) or running_subagents(a["pid"], session)
    return "live child work or subagents: " + "; ".join(busy[:4]) if busy else None


def restart_tile(row, a):
    """Non-forced resume is easl's atomic gate for pending prompts/messages too."""
    row["mem_before_mb"] = mem_mb(row["pid"])
    try:
        easl(a["cli"], "agent.restart", "--target", a["tile"], "--mode", "resume", timeout=120)
    except EaslConflict as e:
        row["action"] = f"skip: easl refused: {e}"
        return
    deadline, last, probe_error = time.time() + VERIFY_S, None, None
    while time.time() < deadline:
        try:
            now = tile_get(a["cli"], a["tile"], timeout=deadline - time.time()) or {}
            if time.time() >= deadline:
                break
            session = tile_session(a["cli"], a["tile"], timeout=deadline - time.time())
            last = now, session
            new, proto = now.get("pid"), now.get("protocol")
            if (time.time() <= deadline and new and new != row["pid"] and session == row["session"]
                    and isinstance(proto, (int, float)) and proto >= 1 and now.get("model") == a["model"]):
                row.update(new_pid=new, session_unchanged=True, mem_after_mb=mem_mb(new), action="restarted")
                return
        except (RuntimeError, OSError, ValueError, subprocess.TimeoutExpired) as e:
            probe_error = str(e)
        time.sleep(min(2, max(0, deadline - time.time())))
    if last is None:
        raise RuntimeError(f"resume verification unavailable after {VERIFY_S} s: {probe_error}; original session: {row['session']}")
    now, session = last
    problem = f"resume not verified within {VERIFY_S} s: pid {now.get('pid')!r}, session {session!r}, protocol {now.get('protocol')!r}, model {now.get('model')!r}"
    row["verification_failure"] = problem
    proto = now.get("protocol")
    row["protocol_model_failure"] = bool(now.get("pid") and now["pid"] != row["pid"]
        and (not isinstance(proto, (int, float)) or proto < 1 or now.get("model") != a["model"]))
    raise RuntimeError(f"{problem}; original session: {row['session']}")


def restart_services(services, installed, dry, pending, res):
    procs = ps_table()
    for svc in services:
        pids = [p for p, i in procs.items() if svc["match"] in i["cmd"] and is_agent_omp(i["cmd"])]
        act = {"kind": "service", "label": svc["label"], "pids": pids}
        res["actions"].append(act)
        try:
            if not pids:
                raise RuntimeError("no running omp matches service")
            if not any(running_version(p, procs[p]["age_s"], installed)[0] for p in pids) and not (dry and pending):
                act["action"] = "none: current"
            elif dry:
                act["action"] = "would restart"
            else:
                sh(["launchctl", "kickstart", "-k", f"gui/{os.getuid()}/{svc['label']}"], timeout=60, check=True)
                for _ in range(30):
                    time.sleep(2)
                    h = sh(["curl", "-s", "-m", "5", "-w", "\n%{http_code}", svc["health"]], timeout=15).stdout
                    body, _, code = h.rpartition("\n")
                    try:
                        reported = json.loads(body).get("version")
                    except (ValueError, AttributeError):
                        reported = None
                    if code == "200" and reported in (None, installed):
                        act["action"] = "restarted"
                        break
                else:
                    raise RuntimeError("service health/version not verified within 60 s")
        except Exception as e:
            act["action"] = f"failed: {e}"
            res["errors"].append(f"service {svc['label']}: {e}")
            return


def host_main(params):
    dry, target = params["dry_run"], params["target"]
    res = {"host": params["host"], "actions": [], "tiles": [], "unmanaged": [], "errors": []}
    installing = False
    try:
        installed = res["installed_before"] = omp_version()
        pending = vtuple(installed) < vtuple(target)
        if pending:
            installing = True
            act = {"kind": "install", "from": installed, "to": target, "dry_run": dry}
            res["actions"].append(act)
            if os.path.realpath(OMP).endswith(".js"):
                if not dry:
                    sh([os.path.join(BUN_BIN, "bun"), "install", "-g", f"{NPM_PKG}@{target}"], timeout=1200, check=True)
            else:
                tmp = stage_binary(target)
                try:
                    if not dry:
                        act["bak"] = os.path.basename(swap_binary(tmp))
                finally:
                    if os.path.exists(tmp):
                        os.remove(tmp)
            if not dry:
                installed = omp_version()
                if installed != target:
                    raise RuntimeError(f"installed {installed}, expected {target}")
            installing = False
        elif vtuple(installed) > vtuple(target):
            res["actions"].append({"kind": "ahead", "installed": installed, "target": target, "note": "not downgraded"})
        res["installed_after"] = installed
        restart_services(params.get("services") or [], installed, dry, pending, res)
        if res["errors"]:
            return res
        if not os.path.realpath(OMP).endswith(".js"):
            res["actions"].extend(prune_baks(dry))
        procs = ps_table()
        ez = params.get("easl")
        tiles = tile_agents(ez["cli"]) if ez else []
        checked_path = False
        for a in tiles:
            row = {"tile": a["tile"], "name": a.get("name"), "pid": a.get("pid"), "status": (a.get("lifecycle") or {}).get("state")}
            res["tiles"].append(row)
            res["actions"].append({"kind": "tile", **row})
            act = res["actions"][-1]
            try:
                if not a.get("name"):
                    row["action"] = "skip: Tim's tile"
                    continue
                if a["name"] in params["report_only"]["names"]:
                    row["action"] = "report: seat/front door (owner decides)"
                    continue
                if a.get("open") is not True:
                    row["action"] = "skip: board closed or unknown"
                    continue
                if not row["pid"]:
                    row["action"] = "none: easl reports no omp pid"
                    continue
                info = procs.get(row["pid"])
                if not info or not is_agent_omp(info["cmd"]):
                    row["action"] = "skip: omp process not confirmed"
                    continue
                older, ver = running_version(row["pid"], info["age_s"], installed)
                rss = info.get("rss_mb") or 0
                triggers = ([f"binary {ver or 'older'} < {target if dry and pending else installed}"] if older or (dry and pending) else [])
                if rss > MAX_RSS_MB:
                    triggers.append(f"rss {rss:g} MB")
                row.update(version=ver, rss_mb=rss, triggers=triggers)
                if not triggers:
                    row["action"] = "none"
                else:
                    session = row["session"] = tile_session(a["cli"], a["tile"])
                    if not session or not session.endswith(".jsonl") or not os.path.isfile(session):
                        row["action"] = "skip: no session file on disk to resume"
                        continue
                    skip = idle_gate(a, procs, session)
                    if not skip and not a.get("model"):
                        skip = "model unknown"
                    if skip:
                        row["action"] = f"skip: {skip}"
                        continue
                    if not checked_path:
                        easl_finds_omp(a["cli"], procs)
                        checked_path = True
                    now = tile_get(a["cli"], a["tile"])
                    if (not now or now.get("pid") != a["pid"] or now.get("name") != a["name"]
                            or now.get("model") != a["model"] or tile_session(a["cli"], a["tile"]) != session):
                        row["action"] = "skip: tile changed since listing"
                        continue
                    skip = idle_gate(now, ps_table(), session)
                    if skip:
                        row["action"] = f"skip: {skip}"
                    elif dry:
                        row["action"] = "would restart"
                    else:
                        restart_tile(row, now)
            except Exception as e:
                row["action"] = f"failed: {e}"
                res["errors"].append(f"{a['tile']}: {e}")
                break
            finally:
                act.update(row)
        managed = {a.get("pid") for a in tiles} | {p for act in res["actions"] if act["kind"] == "service" for p in act["pids"]}
        res["unmanaged"] = [{"pid": p, "action": "report only (outside easl)"}
                            for p, i in procs.items() if p not in managed and is_agent_omp(i["cmd"])]
        res["actions"].extend({"kind": "unmanaged", **row} for row in res["unmanaged"])
    except Exception as e:
        if installing:
            res["install_failure"] = True
            res["actions"][-1]["action"] = f"failed: {e}"
        res["errors"].append(str(e))
    return res


def curl_json(url):
    if url.startswith("https://api.github.com/"):
        r = sh(["gh", "api", url[len("https://api.github.com/"):]], timeout=180)
        if r.returncode == 0:
            return json.loads(r.stdout)
    return json.loads(sh(["curl", "-fsSL", "--retry", "3", url], timeout=180, check=True).stdout)


def resolve_target(min_age_h, blocked=()):
    min_age_h = max(3, min_age_h)
    cutoff = utcnow() - dt.timedelta(hours=min_age_h)
    rels = curl_json(f"https://api.github.com/repos/{REPO}/releases?per_page=30")
    npm = curl_json(f"https://registry.npmjs.org/{NPM_PKG}")
    need = {"omp-darwin-arm64", "omp-linux-x64", "SHA256SUMS.txt"}
    eligible = []
    for r in rels:
        version = r["tag_name"].lstrip("v")
        if (not r["draft"] and not r["prerelease"] and version not in blocked
                and parse_ts(r["published_at"]) <= cutoff and need <= {a["name"] for a in r.get("assets", [])}
                and version in npm.get("versions", {}) and version in npm.get("time", {})
                and parse_ts(npm["time"][version]) <= cutoff):
            eligible.append(version)
    if not eligible:
        raise RuntimeError(f"no unblocked release is on both GitHub and npm and at least {min_age_h} h old")
    return {"target": max(eligible, key=vtuple), "eligible": sorted(eligible, key=vtuple), "blocked": sorted(blocked, key=vtuple)}


def host_target(tinfo, hc):
    hold = hc.get("hold_below")
    below = [v for v in tinfo["eligible"] if not hold or vtuple(v) < vtuple(hold)]
    return max(below, key=vtuple) if below else "0"


def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG + ".tmp", "w") as f:
        json.dump(cfg, f, indent=1)
    os.replace(CONFIG + ".tmp", CONFIG)


def raw_config():
    try:
        with open(CONFIG) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


def update_config(change):
    raw = raw_config()
    before = copy.deepcopy(raw)
    change(raw)
    if raw != before:
        save_config(raw)


def prune_config(raw):
    for key in list(raw):
        if key not in DEFAULT_CONFIG:
            del raw[key]
    for host in list(raw.get("hosts", {})):
        if host not in ORDER:
            del raw["hosts"][host]
            continue
        for key in list(raw["hosts"][host]):
            if key not in HOST_KEYS:
                del raw["hosts"][host][key]
    for key in list(raw.get("report_only", {})):
        if key != "names":
            del raw["report_only"][key]


def load_config():
    raw = raw_config()
    base = copy.deepcopy(DEFAULT_CONFIG)
    cfg = {**base, **{k: v for k, v in raw.items() if k in DEFAULT_CONFIG}}
    cfg["hosts"] = {h: {k: v for k, v in raw.get("hosts", {}).get(h, defaults).items() if k in HOST_KEYS}
                    for h, defaults in base["hosts"].items()}
    cfg["report_only"] = {"names": sorted(set(cfg["report_only"].get("names", [])) | {"lindy-seat"})}
    return cfg


def run_host(name, hc, params):
    if hc.get("ssh"):
        with open(os.path.abspath(__file__)) as f:
            script = f.read()
        cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=20", hc["ssh"],
               f"{hc.get('python', 'python3')} - host {shlex.quote(json.dumps(params))}"]
        r = subprocess.run(cmd, input=script, capture_output=True, text=True, timeout=5400, env=ENV)
    else:
        r = subprocess.run([sys.executable, os.path.abspath(__file__), "host", json.dumps(params)],
                           capture_output=True, text=True, timeout=5400, env=ENV)
    line = next((ln for ln in reversed(r.stdout.splitlines()) if ln.startswith("RESULT ")), None)
    if not line:
        raise RuntimeError(f"host run failed ({r.returncode}): {(r.stderr or r.stdout).strip()[-300:]}")
    res = json.loads(line[7:])
    if r.returncode and not res["errors"]:
        res["errors"].append(f"host exited {r.returncode}")
    return res


def take_lock():
    os.makedirs(STATE, exist_ok=True)
    lock = open(os.path.join(STATE, "run.lock"), "a")
    try:
        flock_wait(lock, 1800)
        return lock
    except Exception:
        lock.close()
        raise


def main_run(args):
    record = {"started": stamp(), "dry_run": args.dry_run, "results": [], "errors": []}
    lock = None
    try:
        selected = args.hosts.split(",") if args.hosts is not None else ORDER
        if set(selected) - set(ORDER):
            raise RuntimeError("--hosts must name deckbox, work or home")
        lock = take_lock()
        if not args.dry_run:
            update_config(prune_config)
        cfg = load_config()
        try:
            with open(os.path.join(STATE, "last-run.json")) as f:
                known = {r["host"]: r.get("installed_after") for r in json.load(f)["results"]}
        except (OSError, ValueError, KeyError, TypeError):
            known = {}
        tinfo = record["target"] = resolve_target(cfg["min_age_hours"], cfg["blocked_versions"] or {})
        for name in (h for h in ORDER if h in selected):
            hc = cfg["hosts"][name]
            params = {"host": name, "target": host_target(tinfo, hc), "dry_run": args.dry_run,
                      "report_only": cfg["report_only"], "services": hc.get("services", []), "easl": host_easl(hc)}
            try:
                res = run_host(name, hc, params)
            except Exception as e:
                res = {"host": name, "actions": [], "tiles": [], "unmanaged": [], "errors": [str(e)]}
            res.update(target=params["target"], hold_below=hc.get("hold_below"))
            record["results"].append(res)
            if res.get("install_failure") or any(t.get("verification_failure") for t in res["tiles"]):
                version = res.get("installed_after")
                later = ORDER[ORDER.index(name) + 1:]
                new = version != res.get("installed_before") or any(vtuple(known.get(h) or "0") < vtuple(version) for h in later)
                if (not args.dry_run and version and new
                        and any(t.get("protocol_model_failure") for t in res["tiles"])):
                    def block(raw):
                        raw.setdefault("blocked_versions", {})[version] = {"reason": res["errors"][0], "host": name, "at": stamp()}
                    update_config(block)
                break
    except Exception as e:
        record["errors"].append(str(e))
    finally:
        record["ended"] = stamp()
        os.makedirs(STATE, exist_ok=True)
        with open(os.path.join(STATE, "actions.jsonl"), "a") as f:
            f.write(json.dumps({"ts": record["started"], "kind": "run", "dry_run": args.dry_run, "target": record.get("target")}) + "\n")
            for res in record["results"]:
                for act in res["actions"]:
                    f.write(json.dumps({"ts": record["ended"], "host": res["host"], "dry_run": args.dry_run, **act}) + "\n")
                for error in res["errors"]:
                    f.write(json.dumps({"ts": record["ended"], "host": res["host"], "kind": "error", "error": error}) + "\n")
            for error in record["errors"]:
                f.write(json.dumps({"ts": record["ended"], "kind": "error", "error": error}) + "\n")
        with open(os.path.join(STATE, "last-run.json"), "w") as f:
            json.dump(record, f, indent=1)
        if lock:
            lock.close()
    print(json.dumps(record, indent=1))
    return int(bool(record["errors"] or any(r["errors"] for r in record["results"])))


def main():
    ap = argparse.ArgumentParser(description="update omp and resume idle easl leads")
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("--dry-run", action="store_true")
    r.add_argument("--hosts")
    sub.add_parser("target")
    h = sub.add_parser("host")
    h.add_argument("params")
    a = ap.parse_args()
    if a.cmd == "host":
        res = host_main(json.loads(a.params))
        print("RESULT " + json.dumps(res))
        return int(bool(res["errors"]))
    if a.cmd == "target":
        cfg = load_config()
        print(json.dumps(resolve_target(cfg["min_age_hours"], cfg["blocked_versions"] or {}), indent=1))
        return 0
    return main_run(a)


if __name__ == "__main__":
    sys.exit(main())
