#!/usr/bin/python3
"""Run one Linux-compatible heavy step (test suite, typecheck, headless build) from a home worktree on deckbox.

  offload [--host deckbox] [--cpus 8] [--mem 16G] [--fetch PATH ...] [--setup CMD] [--big] -- <command> [args...]
  offload [--host deckbox] --clean

1. Sync: the worktree's tracked and untracked-but-not-ignored files (`git ls-files -co --exclude-standard`),
   minus the deny-list (.env*, *.pem, *.key, *id_rsa*, *secret*, matched on every path component) and never
   anything under .git/, go by `rsync --files-from` to <host>:~/offload/<repo>-<12 hex of sha256(worktree
   path)>/. Deletion is limited to synced paths: a path sent before and gone from the worktree now is deleted
   there; ignored directories (node_modules, .venv, target) persist on <host> as that worktree's Linux build
   cache. The paths sent last time are kept in ~/.local/state/offload/manifests/.
   A dry run first measures the change set (new or changed files vs the remote copy) and prints
   `offload: syncing N files, X MB`. Home's uplink is about 0.5 MB/s, so more than 200 MB is refused (exit 2)
   unless --big: ignore build output and media in .gitignore instead. rsync runs with --timeout=120: a sync
   that moves no data for 120 s is aborted, and offload says the sync stalled.
2. Run: `ssh -T <host> python3 ~/dotfiles/agents/shepherd/bin/offload-run ...`: <host>'s heavy-work queue, then
   a systemd unit capped at --cpus and --mem, in the same subdirectory you run offload from, --setup first.
   stdout and stderr stream back; the exit status is the command's. stdin is not forwarded. Ctrl-C, SIGTERM or
   a dropped ssh stops the remote unit.
3. Fetch: each --fetch PATH (relative to the current directory) is copied back to the same place afterwards,
   whatever the exit status. A failed fetch after a passing command exits with rsync's status.
   Cancellation during fetch, like cancellation during sync or run, exits with 128+N for the original signal N.
4. Log: one JSON line per run in ~/.local/state/offload/runs.jsonl.

On <host> itself (deckbox agents running `offload` there), there is nothing to sync: the step runs in place, in
this worktree, through the same queue and the same capped unit, with the same refusal of steps that mention
`git `; --fetch and --clean have nothing to do. The local host is SHEPHERD_HOST, else the short hostname.
Cancellation in place signals only offload-run, which stops its unit before releasing its queue slot. It gets
up to 30 s before its helper group is killed; if offload itself dies, EOF on offload-run's stdin stops the unit.

offload never syncs .git/, and there is no git sync mode. A step whose text mentions `git ` is refused before
anything is sent, and a run whose output says "not a git repository" ends with a loud note: such steps run on
home behind the queue (`machine-ok-queue run -- <command>`).
--clean deletes this worktree's remote directory by its exact path (do it when the worktree goes).
rsync and ssh run in a process group of their own, which offload kills when the stage ends and when it gets
SIGINT, SIGTERM or SIGHUP; a guard leading the group kills it within a second if offload itself is SIGKILLed. So
nothing it started (rsync, the ssh under it, the run's ssh) outlives it.
Exit status: the command's; 2 for usage errors and refusals; 255 when the sync or ssh fails; 128+N on signal N.
"""
import argparse
import datetime as dt
import fnmatch
import hashlib
import json
import os
import re
import shlex
import signal
import socket
import subprocess
import sys
import threading
import time

HERE = os.path.dirname(os.path.realpath(__file__))
REMOTE_HELPER = "~/dotfiles/agents/shepherd/bin/offload-run"
STATE = os.path.expanduser("~/.local/state/offload")
LOG = os.path.join(STATE, "runs.jsonl")
MANIFESTS = os.path.join(STATE, "manifests")
DENY = (".env*", "*.pem", "*.key", "*id_rsa*", "*secret*")
SSH_OPTS = ["-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", "-o", "ServerAliveInterval=15",
            "-o", "ServerAliveCountMax=4"]
BIG_MB = 200  # the change set offload sends without --big (home's uplink: ~0.5 MB/s, so 200 MB is ~7 min)
STALL_S = int(os.environ.get("OFFLOAD_STALL_S", "120"))  # rsync --timeout: this long without data aborts the sync
GROUPS = {}  # group leader pid -> running child; in-place offload-run stops its own systemd unit
STOPPED = []  # signals offload got
GIT_TEXT = re.compile(r"(?<![\w.-])git(\s|$)")
GIT_FAILURE = b"not a git repository"
GIT_NOTE = """offload: ======================================================================
offload: THIS STEP NEEDS GIT METADATA, AND OFFLOAD NEVER SYNCS .git/ (there is no git sync mode).
offload: {why}
offload: Run it on home behind the queue instead:
offload:     machine-ok-queue run -- {command}
offload: ======================================================================"""


def say(text):
    print(f"offload: {text}", file=sys.stderr, flush=True)


def git(*args, cwd):
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, check=True).stdout


def worktree_root(cwd):
    try:
        return os.path.realpath(git("rev-parse", "--show-toplevel", cwd=cwd).decode().strip())
    except (subprocess.CalledProcessError, OSError):
        return None


def remote_name(root):
    repo = re.sub(r"[^A-Za-z0-9._-]", "_", os.path.basename(root)) or "worktree"
    return f"{repo}-{hashlib.sha256(root.encode()).hexdigest()[:12]}"


def denied(path):
    return any(fnmatch.fnmatchcase(part.lower(), pat) for part in path.split("/") for pat in DENY)


def select(root):
    """(paths to send, deny-listed paths): tracked and untracked-but-not-ignored, never under .git/."""
    out = git("ls-files", "-co", "--exclude-standard", "-z", cwd=root).decode("utf-8", "surrogateescape")
    send, deny = [], []
    for path in dict.fromkeys(p for p in out.split("\0") if p):  # -c and -o can both list a path
        if ".git" in path.split("/"):
            continue
        (deny if denied(path) else send).append(path)
    return send, deny


def manifest_path(host, name):
    return os.path.join(MANIFESTS, f"{re.sub(r'[^A-Za-z0-9._-]', '_', host)}-{name}")


def read_manifest(path):
    try:
        with open(path, "rb") as f:
            return [p for p in f.read().decode("utf-8", "surrogateescape").split("\0") if p]
    except OSError:
        return []


def write_manifest(path, paths):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "wb") as f:
        f.write("\0".join(paths).encode("utf-8", "surrogateescape"))
    os.replace(path + ".tmp", path)


def ssh_command():
    return "ssh " + " ".join(SSH_OPTS)


def sync_argv(host, remote, dry_run=False):
    """The sync; with dry_run, the measurement before it (each file it would send as `<bytes> <path>`, then stats)."""
    return ["rsync", "-a", "--from0", "--files-from=-", "--delete-missing-args", "--mkpath", "--stats",
            f"--timeout={STALL_S}", *(["--dry-run", "--out-format=%l %n"] if dry_run else []),
            "-e", ssh_command(), "./", f"{host}:{remote}/"]


def fetch_argv(host, remote, rel):
    return ["rsync", "-a", "-R", f"--timeout={STALL_S}", "-e", ssh_command(), f"{host}:{remote}/./{rel}", "./"]


def helper_args(directory, rel_cwd, cpus, mem, setup, agent, cmd):
    args = ["--dir", directory, "--cwd", rel_cwd, "--cpus", cpus, "--mem", mem]
    if setup:
        args += ["--setup", setup]
    if agent:
        args += ["--agent", agent]
    return [*args, "--", *cmd]


def run_argv(host, remote, rel_cwd, cpus, mem, setup, agent, cmd):
    return ["ssh", *SSH_OPTS, host,
            f"python3 {REMOTE_HELPER} " + shlex.join(helper_args(remote, rel_cwd, cpus, mem, setup, agent, cmd))]


def in_place(host):
    """True when --host names this machine: the step then runs in the worktree itself, with no rsync or ssh."""
    here = os.environ.get("SHEPHERD_HOST") or socket.gethostname().split(".")[0]
    return host.rsplit("@", 1)[-1] in (here, "localhost")


def stats(out):
    def num(label):
        m = re.search(rf"^{label}: ([\d,]+)", out, re.M)
        return int(m.group(1).replace(",", "")) if m else None
    return num("Number of regular files transferred"), num("Total bytes sent")


def change_set(out):
    """(files, bytes, the largest files as (bytes, path)) a dry run would send; bytes None if rsync did not say."""
    m = re.search(r"^Total transferred file size: ([\d,]+)", out, re.M)
    files = [(int(size), path) for size, path in re.findall(r"^(\d+) (.*[^/])$", out, re.M)]
    return stats(out)[0], int(m.group(1).replace(",", "")) if m else None, sorted(files, reverse=True)[:5]


def stop_group(pgid, sig=signal.SIGTERM):
    try:
        os.killpg(pgid, sig)
    except (ProcessLookupError, PermissionError):
        pass


def stop_child(proc, sig):
    if proc.in_place:
        try:
            proc.send_signal(sig)  # leave systemd-run --wait alive until the unit stop completes
        except ProcessLookupError:
            pass
    else:
        stop_group(proc.pid)
    if proc.stop_timer is None:
        proc.stop_timer = threading.Timer(30 if proc.in_place else 5, stop_group, (proc.pid, signal.SIGKILL))
        proc.stop_timer.daemon = True
        proc.stop_timer.start()


def on_signal(sig, _frame):
    """Stop rsync/ssh groups; let in-place offload-run finish stopping its unit (bounded to 30 s)."""
    STOPPED.append(sig)
    for proc in list(GROUPS.values()):
        stop_child(proc, sig)


# Leads each child's process group: runs argv in it and mirrors its exit, and when offload dies first (even by
# SIGKILL, which offload cannot clean up after) its end of the lifeline pipe closes, and the guard kills the group.
GUARD = r"""
import os, select, signal, sys, time
lifeline, argv = int(sys.argv[1]), sys.argv[2:]
pid = os.fork()
if pid == 0:
    os.close(lifeline)
    try:
        os.execvp(argv[0], argv)
    except OSError:
        os._exit(127)
while True:
    done, status = os.waitpid(pid, os.WNOHANG)
    if done:
        code = os.waitstatus_to_exitcode(status)
        if code < 0:  # die the same way, so offload sees what killed its child
            if -code != signal.SIGKILL:
                signal.signal(-code, signal.SIG_DFL)
            os.kill(os.getpid(), -code)
        sys.exit(code)
    if select.select([lifeline], [], [], 0.5)[0] and not os.read(lifeline, 1):  # offload is gone
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        os.killpg(0, signal.SIGTERM)
        end = time.monotonic() + 5
        while time.monotonic() < end and not os.waitpid(pid, os.WNOHANG)[0]:
            time.sleep(0.1)
        os.killpg(0, signal.SIGKILL)
"""


def spawn(argv, in_place=False, **kw):
    """rsync/ssh get a guard and a group lifeline; local offload-run uses its own stdin lifeline and unit cleanup."""
    if in_place:
        proc = subprocess.Popen(argv, start_new_session=True, **kw)
        proc.lifeline = None
    else:
        read_end, write_end = os.pipe()  # offload holds this end until the child ends or offload dies
        try:
            proc = subprocess.Popen([sys.executable, "-c", f"exec({GUARD!r})", str(read_end), *argv],  # one ps line
                                    start_new_session=True, pass_fds=(read_end,), **kw)
        except BaseException:
            os.close(write_end)
            raise
        finally:
            os.close(read_end)
        proc.lifeline = write_end
    proc.in_place = in_place
    proc.stop_timer = None
    GROUPS[proc.pid] = proc
    if STOPPED:  # the signal came while it was starting
        stop_child(proc, STOPPED[0])
    return proc


def reap(proc):
    """After the child ends: kill what is left of its group (an ssh still draining under a timed-out rsync)."""
    GROUPS.pop(proc.pid, None)
    if proc.stop_timer is not None:
        proc.stop_timer.cancel()
    stop_group(proc.pid, signal.SIGKILL)
    if proc.lifeline is not None:
        os.close(proc.lifeline)


def child(argv, data=None, capture=False, **kw):
    """Run argv to the end in its own process group; (exit status, stdout, stderr) as bytes when captured."""
    pipe = subprocess.PIPE if capture else None
    proc = spawn(argv, stdin=subprocess.PIPE if data is not None else None, stdout=pipe, stderr=pipe, **kw)
    try:
        out, err = proc.communicate(data)
    finally:
        reap(proc)
    return proc.returncode, out or b"", err or b""


def log(row):
    os.makedirs(STATE, exist_ok=True)
    with open(LOG, "a") as f:
        f.write(json.dumps(row) + "\n")


def pump(src, dst, seen):
    """Copy a stream through as it arrives, noting whether git's "not a git repository" went by."""
    tail = b""
    while True:
        chunk = os.read(src.fileno(), 65536)
        if not chunk:
            return
        dst.write(chunk)
        dst.flush()
        if GIT_FAILURE in (tail + chunk).lower():
            seen.set()
        tail = chunk[-len(GIT_FAILURE):]


def parse(argv):
    cut = argv.index("--") if "--" in argv else len(argv)
    ap = argparse.ArgumentParser(prog="offload", allow_abbrev=False, description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__.split("\n\n", 1)[1],
                                 usage="offload [--host deckbox] [--cpus 8] [--mem 16G] [--fetch PATH ...] "
                                       "[--setup CMD] [--big] -- <command> [args...]\n"
                                       "       offload [--host deckbox] --clean")
    ap.add_argument("--host", default="deckbox")
    ap.add_argument("--cpus", default="8")
    ap.add_argument("--mem", default="16G")
    ap.add_argument("--fetch", action="append", default=[], metavar="PATH")
    ap.add_argument("--setup", metavar="CMD")
    ap.add_argument("--clean", action="store_true")
    ap.add_argument("--big", action="store_true", help=f"send a change set over {BIG_MB} MB")
    a = ap.parse_args(argv[:cut])
    a.command = argv[cut + 1:]
    if a.clean and (a.command or a.fetch or a.setup):
        ap.error("--clean takes no command, --fetch or --setup")
    if not a.clean and not a.command:
        ap.error("give the command after --")
    try:
        if float(a.cpus) <= 0:
            raise ValueError
    except ValueError:
        ap.error(f"--cpus {a.cpus}: a positive number")
    if not re.fullmatch(r"\d+(\.\d+)?[KMGT]?", a.mem):
        ap.error(f"--mem {a.mem}: a size like 16G or 512M")
    return a


def sync_failed(host, remote, what, code, err):
    sys.stderr.write(err.decode("utf-8", "replace"))
    if code == 30:  # rsync: timeout in data send/receive
        say(f"the {what} to {host}:~/{remote} stalled: no data for {STALL_S}s, so rsync gave up (exit 30); "
            "the step did not run")
    else:
        say(f"the {what} to {host}:~/{remote} failed (rsync exit {code}); the step did not run")
    return 255


def main(argv):
    a = parse(argv)
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, on_signal)
    cwd = os.path.realpath(os.getcwd())
    root = worktree_root(cwd)
    if not root:
        say("run it inside a git worktree: the worktree is what gets synced")
        return 2
    name = remote_name(root)
    remote = f"offload/{name}"
    manifest = manifest_path(a.host, name)
    local = in_place(a.host)
    if a.clean:
        if local:
            say(f"this is {a.host}: offload runs in place here, so there is no remote copy to clean")
            return 0
        code = child(["ssh", *SSH_OPTS, a.host, f'rm -rf -- "$HOME"/offload/{shlex.quote(name)}'])[0]
        if STOPPED:
            return 128 + STOPPED[0]
        if code:
            say(f"removing {a.host}:~/{remote} failed (ssh exit {code})")
            return 255
        if os.path.exists(manifest):
            os.unlink(manifest)
        say(f"removed {a.host}:~/{remote}")
        return 0

    text = " ".join([a.setup or "", *a.command])
    if GIT_TEXT.search(text):
        print(GIT_NOTE.format(why="This step's text runs `git `, and nothing under .git/ exists on the remote side.",
                              command=shlex.join(a.command)), file=sys.stderr)
        say("refused before syncing anything")
        return 2
    fetch = []
    for p in a.fetch:
        rel = os.path.relpath(os.path.join(cwd, p), root)
        if rel == "." or rel.startswith(".." + os.sep) or rel == ".." or ".git" in rel.split(os.sep):
            say(f"--fetch {p}: must name a path inside the worktree, other than the worktree itself and .git")
            return 2
        fetch.append(rel)

    rel_cwd = os.path.relpath(cwd, root)
    agent = os.environ.get("EASL_TILE_ID") or os.environ.get("HERDR_PANE_ID")
    send, deny, gone, files, sent, sync_s = [], [], [], None, None, 0.0
    if local:
        if fetch:
            say("runs in place on this host: --fetch has nothing to copy back")
            fetch = []
        argv = [sys.executable, os.path.join(HERE, "offload-run"),
                *helper_args(root, rel_cwd, a.cpus, a.mem, a.setup, agent, a.command)]
    else:
        send, deny = select(root)
        if deny:
            say(f"not sent (deny-list): {', '.join(deny)}")
        sending = set(send)
        gone = [p for p in read_manifest(manifest) if p not in sending and not os.path.lexists(os.path.join(root, p))]
        files_from = "\0".join(send + gone).encode("utf-8", "surrogateescape")
        t0 = time.monotonic()
        code, out, err = child(sync_argv(a.host, remote, dry_run=True), files_from, capture=True, cwd=root)
        if STOPPED:
            return 128 + STOPPED[0]
        if code not in (0, 24):  # 24: a file vanished mid-transfer
            return sync_failed(a.host, remote, "sync's dry run", code, err)
        files, size, largest = change_set(out.decode("utf-8", "replace"))
        say(f"syncing {files} files, " + ("size unknown" if size is None else f"{size / 1e6:.1f} MB"))
        if size is not None and size > BIG_MB * 1e6 and not a.big:
            say(f"refused: {size / 1e6:.0f} MB is over {BIG_MB} MB, and home's uplink (about 0.5 MB/s) would take "
                f"about {size / 0.5e6 / 60:.0f} min and clog the link for every agent. Largest files:")
            for n, path in largest:
                say(f"    {n / 1e6:9.1f} MB  {path}")
            say("Ignore build output and media in .gitignore (ignored paths are never sent), or pass --big if the "
                "step really needs them.")
            return 2
        code, out, err = child(sync_argv(a.host, remote), files_from, capture=True, cwd=root)
        sync_s = round(time.monotonic() - t0, 2)
        if STOPPED:
            return 128 + STOPPED[0]
        if code not in (0, 24):
            return sync_failed(a.host, remote, "sync", code, err)
        write_manifest(manifest, [p for p in send if os.path.lexists(os.path.join(root, p))])
        files, sent = stats(out.decode("utf-8", "replace"))
        say(f"synced {len(send)} paths ({files} changed, {sent} bytes sent, {len(gone)} deleted) to "
            f"{a.host}:~/{remote} in {sync_s}s")
        argv = run_argv(a.host, remote, rel_cwd, a.cpus, a.mem, a.setup, agent, a.command)

    t1 = time.monotonic()
    # Ending ssh (a signal stops its group) closes the remote stdin; offload-run then stops the unit.
    proc = spawn(argv, in_place=local, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    seen = threading.Event()
    pumps = [threading.Thread(target=pump, args=(proc.stdout, sys.stdout.buffer, seen)),
             threading.Thread(target=pump, args=(proc.stderr, sys.stderr.buffer, seen))]
    for t in pumps:
        t.start()
    try:
        code = proc.wait()
    finally:
        reap(proc)
    for t in pumps:
        t.join()
    proc.stdin.close()
    run_s = round(time.monotonic() - t1, 2)
    if STOPPED:
        code = 128 + STOPPED[0]
    elif code < 0:  # ssh (or the in-place offload-run) was killed; offload-run stops the unit when its stdin closes
        say(f"{'offload-run' if local else 'ssh to ' + a.host} was killed by signal {-code}; the step is stopped")
        code = 255
    elif code == 255 and not local:
        say(f"ssh to {a.host} failed or the remote side exited 255")

    fetched = []
    for rel in fetch:
        if STOPPED:
            break
        f = child(fetch_argv(a.host, remote, rel), cwd=root)[0]
        fetched.append({"path": rel, "exit": f})
        if STOPPED:
            break
        if f:
            say(f"fetch {rel} " + (f"stalled: no data for {STALL_S}s (rsync exit 30)" if f == 30
                                   else f"failed (rsync exit {f})"))
            if code == 0:
                code = f
    if STOPPED:
        code = 128 + STOPPED[0]
    if seen.is_set():
        print(GIT_NOTE.format(why="The run failed with \"not a git repository\": nothing under .git/ exists there.",
                              command=shlex.join(a.command)), file=sys.stderr)
    log({"ts": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "host": a.host, "worktree": root,
         "inPlace": local, "remote": None if local else f"~/{remote}", "cwd": rel_cwd, "command": a.command,
         "setup": a.setup, "cpus": a.cpus,
         "mem": a.mem, "paths": len(send), "denied": len(deny), "deleted": len(gone), "sync_files": files,
         "sync_bytes": sent, "sync_s": sync_s, "run_s": run_s, "exit": code, "fetch": fetched,
         "git_needed": seen.is_set(), "signal": STOPPED[0] if STOPPED else None})
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
