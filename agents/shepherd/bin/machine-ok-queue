#!/usr/bin/python3
"""The heavy-work queue: heavy steps on a host take turns, a fixed number at a time, first come first served.

  machine-ok-queue run [--gpu] [--cpu-gate] [--p-cores] [--gate PATH | --no-gate] [--agent NAME] -- <command> [args...]
  machine-ok-queue status
  machine-ok-queue log --from 2026-10-07T21:00Z --to 2026-10-07T21:45Z

`run` takes a ticket and waits, first come first served within its lane (rule 4), until all four hold:
  1. its ticket is the oldest live one still waiting in its line (a ticket whose process died is dropped);
  2. a slot is free: slots per host in ~/.config/machine-shepherd/slots.json, e.g. {"twaldin-home": 2};
     built in: twaldin-home 2, twaldin-work 1, deckbox 3, any other host 1;
  3. the gate passes: `machine-ok --memory [--gpu]` exits 0. The gate stops memory emergencies only: the
     admitted command runs clamped (below), so CPU busyness need not hold it, and on 2026-10-07 the CPU
     criterion only added waits (the full gate passed 97% of samples). --cpu-gate asks for the full gate,
     `machine-ok [--gpu]`; --memory is accepted and is the default. The gate is the machine-ok next to this
     file as invoked (~/.local/bin/machine-ok for the installed link), else the one on PATH; machine-ok itself
     is unchanged and knows nothing of the queue. --gate PATH names another gate. On Linux (deckbox), where
     there is no machine-ok, admission is by slots alone and the gate flags are accepted and ignored (one note
     says so); --no-gate asks for that anywhere. On a Mac a missing machine-ok is an error (exit 2);
  4. its lane admits it. A quiet-window booking or hold (quiet-windows.json, quiet-holds.json) is active from
     10 min before its start (30 for a full-quiet one) to its end (bench ruling heavy-only-holds-queue-clamp-
     ruling-1). Each ticket is in one lane:
       owner       its caller owns every active hold: normal clamp and slots, and it passes the foreign tickets
                   (only owner tickets count as ahead of it);
       heavy-hold  an active heavy-only hold is someone else's (no full one): admitted to one slot at most among
                   such tickets, behind every older ticket not paused, run with `taskpolicy -b` and nice 10;
       paused      an active full-quiet hold is someone else's: it waits until that hold ends;
       normal      no hold is active: everyone is back in the original order.
     A hold's owner is matched against each of the caller's names: the easl tile id, the tile's name and
     address (from `easl agent.list`, the CLI in ~/.config/machine-shepherd/easl.json or on PATH), the herdr
     agent name, HERDR_PANE_ID, and --agent. The lookups take 5 s at most; when easl or herdr is unreachable
     the ids still match.
Then it runs the command holding the slot and exits with its status (128+N when signal N killed it).
On macOS the command runs clamped so Tim's input and UI always win over it: `taskpolicy -c utility` (a QoS
ceiling) and nice 10, both inherited by every child and grandchild (see CLAMP). --p-cores, only for a job that
genuinely needs P-cores at full priority, runs it unclamped; the admit line in queue.jsonl and `status` say so.
Linux (deckbox) runs commands as they are: offload's units carry their own CPUQuota.
SIGTERM, SIGINT and SIGHUP are forwarded to the command; SIGINT is not when it came from this terminal,
which delivered it to the command already. Only the oldest waiter samples the gate: every 30 s while the
machine is busy. A job admitted before a hold keeps running; quiet-window's STOP NOW still covers it.
`status` prints who runs and who waits, since when, in which lane, and what holds are active. `log` prints, one
JSON line each, every job whose run overlaps the window (caller, command prefix, slot, clamp, lane, hold, state,
wait s, run s, exit) and every cancel inside it: the excerpt an armed run's record attaches. A job never released
whose ticket is no longer held is not running: its state is "unknown (pre-release-logging or crashed)".

Files, in ~/.local/state/machine-ok/: queue/<n>.json, one ticket per waiter or runner (pid, start, cwd,
agent, command), flock'ed by its process for as long as it lives, so a ticket nobody holds is dead;
queue/slot-<n>.lock, flock'ed by the process running in that slot, so a crash or kill frees the slot by
itself; queue/counter and queue/queue.lock, the ticket counter and the lock every ticket read and write
takes; queue.jsonl, one line per admit and release (wait s, run s, gate sample), per cancel, and per
ticket waiting more than 30 min (naming the slot holders). macOS has no flock(1), hence Python.
"""
import datetime as dt
import fcntl
import json
import os
import platform
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import time

STATE = os.path.expanduser("~/.local/state/machine-ok")
QUEUE = os.path.join(STATE, "queue")
LOG = os.path.join(STATE, "queue.jsonl")
CONF = os.path.expanduser("~/.config/machine-shepherd")
SLOTS = os.path.join(CONF, "slots.json")
WINDOWS = (os.path.join(CONF, "quiet-windows.json"), os.path.join(CONF, "quiet-holds.json"))
EASL_CONF = os.path.join(CONF, "easl.json")
IDENTITY_TIMEOUT_S = 5  # easl agent.list and herdr agent list answer in well under a second when they are up
DEFAULT_SLOTS = {"twaldin-home": 2, "twaldin-work": 1, "deckbox": 3}
HOLD_LEAD_MIN, FULL_HOLD_LEAD_MIN = 10, 30
# Seconds: a ticket waiting longer is logged once; a waiter's look at the queue; the head's gate re-sample
# while the machine is busy. The environment overrides them for tests.
LONG_WAIT_S = float(os.environ.get("MACHINE_OK_QUEUE_LONG_WAIT", 30 * 60))
POLL_S = float(os.environ.get("MACHINE_OK_QUEUE_POLL", "2"))
GATE_RETRY_S = float(os.environ.get("MACHINE_OK_QUEUE_GATE_RETRY", "30"))
FORWARDED = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)
USAGE = ("usage: machine-ok-queue run [--gpu] [--cpu-gate] [--p-cores] [--gate PATH | --no-gate] [--agent NAME] -- "
         "<command> [args...]\n"
         "       machine-ok-queue status\n"
         "       machine-ok-queue log --from <UTC, e.g. 2026-10-07T21:00Z> --to <UTC>")
# macOS: every admitted command runs clamped, so Tim's input and UI always win (2026-10-07 19:28Z: one admitted
# capture job fanned out headless Chromium + ffmpeg, held CPU idle at 0% for 3 min, and starved skhd/yabai's event
# taps; keys dropped and reordered system-wide; a slot caps the number of jobs, not a job's own fan-out). The QoS
# clamp and the nice value are inherited by every child and grandchild; the command cannot raise itself above them.
# Chosen by A/B against `taskpolicy -b`: see the A/B note below. --p-cores runs a job that genuinely needs them
# unclamped, and says so in queue.jsonl and `status`.
CLAMP = {"argv": ["/usr/sbin/taskpolicy", "-c", "utility", "--"], "nice": 10, "label": "taskpolicy -c utility, nice 10"}
UNCLAMPED = {"argv": [], "nice": 0, "label": "none: --p-cores opt-out"}
# A foreign ticket admitted during someone's heavy-only hold (bench ruling heavy-only-holds-queue-clamp-ruling-1):
# background QoS (E-cores only, I/O throttled) and nice 10, in one slot at most, behind the memory gate.
BACKGROUND = {"argv": ["/usr/sbin/taskpolicy", "-b", "--"], "nice": 10, "label": "taskpolicy -b, nice 10 (heavy hold)"}
HEAVY_HOLD_SLOTS = 1


class Stopped(Exception):
    """A signal ended the wait before admission."""

    def __init__(self, sig):
        super().__init__(sig)
        self.sig = sig


def host():
    return os.environ.get("SHEPHERD_HOST") or socket.gethostname().split(".")[0]


def slot_count():
    try:
        with open(SLOTS) as f:
            n = json.load(f).get(host())
        if isinstance(n, int) and n > 0:
            return n
    except (OSError, ValueError, AttributeError):
        pass
    return DEFAULT_SLOTS.get(host(), 1)


def now():
    return dt.datetime.now(dt.timezone.utc)


def stamp(t=None):
    return (t or now()).strftime("%Y-%m-%dT%H:%M:%SZ")


def since(text):
    return (now() - dt.datetime.strptime(text, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=dt.timezone.utc)).total_seconds()


def span(seconds):
    s = int(seconds)
    return f"{s // 3600}h{s // 60 % 60:02d}m" if s >= 3600 else f"{s // 60}m{s % 60:02d}s"


def log(event, **fields):
    os.makedirs(STATE, exist_ok=True)
    with open(LOG, "a") as f:
        f.write(json.dumps({"ts": stamp(), "event": event, "host": host(), **fields}) + "\n")


def say(text):
    print(f"machine-ok-queue: {text}", file=sys.stderr, flush=True)


def ask(argv, env=None):
    """stdout of a lookup command, or None when it fails or outlasts IDENTITY_TIMEOUT_S (its whole process group is
    killed then, so a hung CLI's children cannot hold the pipe open)."""
    try:
        p = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             text=True, env=env, start_new_session=True)
    except OSError:
        return None
    try:
        out, _ = p.communicate(timeout=IDENTITY_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        os.killpg(p.pid, signal.SIGKILL)
        p.wait()
        p.stdout.close()
        return None
    return out if p.returncode == 0 else None


def easl_cli():
    """The easl CLI named in ~/.config/machine-shepherd/easl.json, else `easl` on PATH."""
    try:
        with open(EASL_CONF) as f:
            cli = json.load(f).get("cli")
    except (OSError, ValueError, AttributeError):
        cli = None
    return cli if cli and os.access(cli, os.X_OK) else shutil.which("easl")


def identity():
    """(agent, pane, names): the caller's display name, its herdr pane, and every name a quiet-window hold may give
    as its owner: the easl tile id, the tile's name and address (`name@board`) from `easl agent.list`, the herdr
    agent name and the pane id. Looked up once per run; an unreachable easl or herdr leaves the ids alone."""
    tile, pane = os.environ.get("EASL_TILE_ID"), os.environ.get("HERDR_PANE_ID")
    names, agent = {x for x in (tile, pane) if x}, tile or pane
    cli = easl_cli() if tile else None
    if cli:
        out = ask([cli, "agent.list"], env={**os.environ, "PATH": os.path.expanduser("~/.bun/bin") + ":"
                                            + os.environ.get("PATH", "")})
        try:
            for a in json.loads(out)["agents"] if out else []:
                if isinstance(a, dict) and a.get("tile") == tile:
                    names.update(x for x in (a.get("name"), a.get("address")) if x)
                    agent = a.get("name") or agent
        except (ValueError, KeyError, TypeError):
            pass
    if pane:
        out = ask(["herdr", "agent", "list"])
        try:
            name = {a["pane_id"]: a.get("name") for a in json.loads(out)["result"]["agents"]}.get(pane) if out else None
        except (ValueError, KeyError, TypeError):
            name = None
        if name:
            names.add(name)
            agent = agent if tile else name
    return agent, pane, names


class Lock:
    """The queue lock: every ticket read and write happens under it, so nobody reads a half-written ticket."""

    def __enter__(self):
        os.makedirs(QUEUE, exist_ok=True)
        self.fd = os.open(os.path.join(QUEUE, "queue.lock"), os.O_RDWR | os.O_CREAT, 0o644)
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        os.close(self.fd)


def tickets():
    """Live tickets, oldest first, as (number, row); dead ones are removed. Call under Lock."""
    rows = []
    for name in os.listdir(QUEUE):
        stem, ext = os.path.splitext(name)
        if ext != ".json" or not stem.isdigit():
            continue
        path = os.path.join(QUEUE, name)
        try:
            fd = os.open(path, os.O_RDONLY)
        except FileNotFoundError:
            continue
        try:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                with os.fdopen(os.dup(fd)) as f:
                    try:
                        rows.append((int(stem), json.load(f)))
                    except ValueError:
                        rows.append((int(stem), {}))
                continue
            os.unlink(path)  # nobody holds it: its process is gone
        finally:
            os.close(fd)
    return sorted(rows, key=lambda r: r[0])


def held_slots(rows):
    return {r.get("slot"): r for _, r in rows if r.get("state") == "running"}


def active_holds():
    """Every quiet-window booking or hold that runs now or starts within its lead (10 min, 30 for full quiet)."""
    t, active = now(), []
    for path in WINDOWS:
        try:
            with open(path) as f:
                rows = json.load(f)
        except (OSError, ValueError):
            continue
        for w in rows if isinstance(rows, list) else []:
            try:
                start = dt.datetime.strptime(w["start"].rstrip("Z"), "%Y-%m-%dT%H:%M").replace(tzinfo=dt.timezone.utc)
                end = dt.datetime.strptime(w["end"].rstrip("Z"), "%Y-%m-%dT%H:%M").replace(tzinfo=dt.timezone.utc)
            except (KeyError, TypeError, ValueError, AttributeError):
                continue
            lead = dt.timedelta(minutes=FULL_HOLD_LEAD_MIN if w.get("quiet") == "full" else HOLD_LEAD_MIN)
            if start - lead <= t < end:
                active.append(w)
    return active


def lane(holds, names):
    """(lane, hold) of a ticket with these names, given the active holds:
    paused      an active full-quiet hold it does not own: it waits until that hold is over;
    heavy-hold  an active heavy-only hold it does not own (no full one): one foreign slot, background clamp;
    owner       it owns every active hold: its normal clamp and slots, ahead of the foreign tickets;
    normal      no hold is active."""
    foreign = [w for w in holds if w.get("owner") not in names]
    full = next((w for w in foreign if w.get("quiet") == "full"), None)
    if full:
        return "paused", full
    if foreign:
        return "heavy-hold", foreign[0]
    return ("owner", holds[0]) if holds else ("normal", None)


def ticket_names(r):
    """Every name a ticket's caller goes by (tickets written before names were stored: agent and pane)."""
    return set(r.get("names") or [x for x in (r.get("agent"), r.get("pane")) if x])


def hold_text(w):
    level = "full quiet" if w.get("quiet") == "full" else "heavy"
    return f"quiet-window hold {w.get('owner')} {w['start'][11:16]}-{w['end'][11:16]}Z ({level}): {w.get('label', '')}"


def take_slot(n):
    """An fd holding a free slot's flock, or None. The fd stays with this process: its death frees the slot."""
    for i in range(1, n + 1):
        fd = os.open(os.path.join(QUEUE, f"slot-{i}.lock"), os.O_RDWR | os.O_CREAT, 0o644)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return i, fd
        except BlockingIOError:
            os.close(fd)
    return None, None


def gate(argv):
    """(passed, sample): the gate's verdict and the sample line it printed."""
    if argv is None:
        return True, None
    try:
        r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        return False, "gate timed out"
    if r.returncode > 1:
        raise SystemExit(f"machine-ok-queue: the gate {shlex.join(argv)} failed (exit {r.returncode}): {r.stderr.strip()}")
    return r.returncode == 0, r.stdout.strip()


def from_terminal():
    """True when this process group is its terminal's foreground group: a SIGINT from it reached the command too."""
    try:
        fd = os.open("/dev/tty", os.O_RDONLY | os.O_NOCTTY)
    except OSError:
        return False
    try:
        return os.tcgetpgrp(fd) == os.getpgrp()
    except OSError:
        return False
    finally:
        os.close(fd)


def runnable(cmd):
    """None when cmd[0] can be started, else (exit status, reason) as a shell reports them. Checked before spawning
    because a clamp wrapper (taskpolicy) would report its own status (66) instead."""
    if shutil.which(cmd[0]):
        return None
    if os.sep in cmd[0] and os.path.exists(cmd[0]):
        return 126, "Permission denied"
    return 127, "No such file or directory"


def run(cmd, gate_argv, flags=(), agent=None, stdin=None, forward=None, clamp=None):
    """Queue, then run cmd holding a slot; returns its exit status (128+N for signal N).
    forward(proc, sig) delivers a signal to the running command; the default sends it to the child.
    clamp (CLAMP or UNCLAMPED, macOS only) wraps the command in its argv prefix and nice value; None runs it as is."""
    me_agent, pane, me = identity()
    agent = agent or me_agent
    me = me | ({agent} if agent else set())
    forward = forward or (lambda proc, sig: proc.send_signal(sig))
    state = {"proc": None, "spawning": False, "pending": []}

    def on_signal(sig, _frame):
        if state["proc"] is not None:
            if not (sig == signal.SIGINT and from_terminal()):
                forward(state["proc"], sig)
        elif state["spawning"]:
            state["pending"].append(sig)
        else:
            raise Stopped(sig)

    for sig in FORWARDED:
        signal.signal(sig, on_signal)

    os.makedirs(QUEUE, exist_ok=True)
    row = {"pid": os.getpid(), "host": host(), "started": stamp(), "cwd": os.getcwd(), "agent": agent, "pane": pane,
           "names": sorted(me), "command": cmd, "flags": list(flags), "clamp": clamp and clamp["label"],
           "state": "waiting", "slot": None, "admitted": None}
    with Lock():
        counter = os.path.join(QUEUE, "counter")
        try:
            with open(counter) as f:
                n = int(f.read().strip() or 0) + 1
        except (OSError, ValueError):
            n = 1
        with open(counter + ".tmp", "w") as f:
            f.write(f"{n}\n")
        os.replace(counter + ".tmp", counter)
        row["ticket"] = n
        tfd = os.open(os.path.join(QUEUE, f"{n:010d}.json"), os.O_RDWR | os.O_CREAT | os.O_EXCL, 0o644)
        fcntl.flock(tfd, fcntl.LOCK_EX)
        os.write(tfd, json.dumps(row).encode())

    def save():
        os.lseek(tfd, 0, os.SEEK_SET)
        os.ftruncate(tfd, 0)
        os.write(tfd, json.dumps(row).encode())

    slot = sfd = None
    said = None
    long_logged = False
    next_gate = 0.0
    sample = None
    try:
        while True:
            slots = slot_count()  # every pass: a slots.json change reaches tickets already waiting
            with Lock():
                live = tickets()
                running = held_slots(live)
            # Each ticket's lane (see lane()) decides who counts as ahead of it. FIFO holds within the line it waits
            # in: the owner lane counts only owner tickets, so a hold's owner passes the foreign tickets; a foreign
            # ticket in a heavy-only hold counts every ticket not paused; with no hold active everyone is back in the
            # original order. Only the head of a line samples the gate.
            holds = active_holds()
            kind, hold = lane(holds, me)
            lanes = {t: lane(holds, ticket_names(r))[0] for t, r in live}
            counted = ("owner", "normal") if kind in ("owner", "normal") else ("owner", "normal", "heavy-hold")
            ahead = [] if kind == "paused" else [t for t, r in live if t < n and r.get("state") != "running"
                                                  and lanes[t] in counted]
            foreign_running = [s for s, r in running.items() if lanes.get(r.get("ticket")) == "heavy-hold"]
            if kind == "paused":
                why = f"queue paused by {hold_text(hold)}"
            elif ahead:
                why = f"queued as ticket {n}: {len(ahead)} ahead, {len(running)}/{slots} slots busy"
            elif kind == "heavy-hold" and len(foreign_running) >= HEAVY_HOLD_SLOTS:
                why = (f"ticket {n} is next; during {hold_text(hold)} other agents' steps get {HEAVY_HOLD_SLOTS} "
                       f"slot at background priority, and it is busy (slot {foreign_running[0]})")
            elif time.monotonic() < next_gate:
                why = said  # the machine was busy at the last sample; keep waiting quietly
            else:
                slot, sfd = take_slot(slots)
                if slot is None:
                    why = f"ticket {n} is next: all {slots} slots busy"
                else:
                    passed, sample = gate(gate_argv)
                    if passed:
                        state["spawning"] = True  # from here a signal waits for the command, which gets it
                        break
                    os.close(sfd)
                    slot = sfd = None
                    next_gate = time.monotonic() + GATE_RETRY_S
                    why = f"ticket {n} is next; machine busy ({sample}); re-checking every {int(GATE_RETRY_S)}s"
            if why != said:
                say(why)
                said = why
            waited = since(row["started"])
            if waited > LONG_WAIT_S and not long_logged:
                holders = [{"slot": s, "ticket": r.get("ticket"), "agent": r.get("agent"),
                            "command": r.get("command"), "admitted": r.get("admitted")} for s, r in sorted(running.items())]
                log("long-wait", ticket=n, agent=agent, cwd=row["cwd"], command=cmd, wait_s=round(waited), reason=why,
                    holders=holders)
                say(f"ticket {n} has waited {span(waited)}; slot holders: "
                    + ("; ".join(f"slot {h['slot']} {h['agent']} {shlex.join(h['command'] or [])}" for h in holders) or "none"))
                long_logged = True
            time.sleep(POLL_S)
    except Stopped as e:
        if sfd is not None:
            os.close(sfd)
        log("cancel", ticket=n, agent=agent, cwd=row["cwd"], command=cmd, wait_s=round(since(row["started"])),
            signal=e.sig)
        os.unlink(os.path.join(QUEUE, f"{n:010d}.json"))
        os.close(tfd)
        return 128 + e.sig

    waited = since(row["started"])
    if kind == "heavy-hold" and clamp is not None:  # macOS: a foreign step in a heavy-only hold runs at background
        clamp = BACKGROUND
    row.update(state="running", slot=slot, admitted=stamp(), clamp=clamp and clamp["label"], lane=kind,
               hold=hold and hold.get("id"))
    with Lock():
        save()
    log("admit", ticket=n, pid=os.getpid(), slot=slot, slots=slots, agent=agent, pane=pane, cwd=row["cwd"], command=cmd,
        flags=list(flags), wait_s=round(waited, 1), gate=sample, clamp=clamp and clamp["label"], lane=kind,
        hold=hold and (hold.get("id") or f"{hold.get('start')}-{hold.get('owner')}"))
    say(f"ticket {n} admitted to slot {slot}/{slots} after {span(waited)}" + (f" ({sample})" if sample else "")
        + (f"; clamp: {clamp['label']}" if clamp else "")
        + (f"; {kind} lane of {hold_text(hold)}" if hold else ""))
    started = time.monotonic()
    code = None
    try:
        if state["pending"]:  # stopped between admission and start: the command never runs
            code = 128 + state["pending"][0]
        else:
            failed = runnable(cmd)
            try:
                if failed:
                    raise OSError(failed[0], failed[1])
                state["proc"] = subprocess.Popen(
                    [*clamp["argv"], *cmd] if clamp else cmd, stdin=stdin,
                    preexec_fn=(lambda: os.nice(clamp["nice"])) if clamp and clamp["nice"] else None)
            except OSError as e:
                say(f"cannot run {shlex.join(cmd)}: {e.strerror}")
                code = failed[0] if failed else 127 if isinstance(e, FileNotFoundError) else 126
            else:
                for sig in state["pending"]:  # arrived while the child was being started
                    forward(state["proc"], sig)
                rc = state["proc"].wait()
                code = 128 - rc if rc < 0 else rc
    finally:
        log("release", ticket=n, slot=slot, agent=agent, cwd=row["cwd"], command=cmd, wait_s=round(waited, 1),
            run_s=round(time.monotonic() - started, 1), exit=code)
        with Lock():
            os.unlink(os.path.join(QUEUE, f"{n:010d}.json"))
        os.close(sfd)
        os.close(tfd)
    return code


def listing():
    """Running and waiting tickets, and what pauses the queue, as printed by `machine-ok-queue status`."""
    os.makedirs(QUEUE, exist_ok=True)
    with Lock():
        live = tickets()
    slots = slot_count()
    running = [(t, r) for t, r in live if r.get("state") == "running"]
    waiting = [(t, r) for t, r in live if r.get("state") != "running"]
    out = [f"machine-ok queue on {host()}: {len(running)}/{slots} slots busy, "
           + (f"{len(waiting)} waiting" if waiting else "none waiting")]
    holds = active_holds()
    for hold in holds:
        out.append(f"paused (no new admissions except its owner's) by {hold_text(hold)}" if hold.get("quiet") == "full"
                   else f"heavy-only hold: other agents' steps get {HEAVY_HOLD_SLOTS} slot at background priority, "
                        f"by {hold_text(hold)}")
    if running:
        out.append("running:")
        for t, r in sorted(running, key=lambda x: x[1].get("slot") or 0):
            out.append(f"  slot {r.get('slot')}  ticket {t}  since {r.get('admitted')} ({span(since(r['admitted']))})"
                       f"  {r.get('agent') or '?'}  pid {r.get('pid')}  {r.get('cwd')}  $ {shlex.join(r.get('command') or [])}"
                       + (f"  [clamp: {r['clamp']}]" if r.get("clamp") else "")
                       + (f"  ({r['lane']} lane)" if r.get("lane") not in (None, "normal") else ""))
    if waiting:
        out.append("waiting:")
        for i, (t, r) in enumerate(waiting, 1):
            out.append(f"  {i}. ticket {t}  since {r.get('started')} ({span(since(r['started']))})  {r.get('agent') or '?'}"
                       f"  pid {r.get('pid')}  {r.get('cwd')}  $ {shlex.join(r.get('command') or [])}"
                       f"  [{' '.join(r.get('flags') or []) or 'full gate'}]"
                       + {"paused": "  (paused by the hold)", "owner": "  (owner lane)",
                          "heavy-hold": "  (heavy hold: one background slot)"}.get(lane(holds, ticket_names(r))[0], ""))
    return "\n".join(out)


def parse_utc(text):
    """2026-10-07T21:00Z or 2026-10-07T21:00:30Z -> aware datetime."""
    for fmt in ("%Y-%m-%dT%H:%M:%SZ", "%Y-%m-%dT%H:%MZ"):
        try:
            return dt.datetime.strptime(text, fmt).replace(tzinfo=dt.timezone.utc)
        except ValueError:
            pass
    raise ValueError(f"not a UTC time like 2026-10-07T21:00Z: {text!r}")


UNKNOWN = "unknown (pre-release-logging or crashed)"


def excerpt(t_from, t_to):
    """queue.jsonl for a window, one JSON line each: every job whose run [admit, release] overlaps it, then every
    cancel inside it. For armed-run records (bench). A job's state is released, running (its ticket is still held on
    this host), or UNKNOWN: admitted, never released, and its ticket is gone (admitted before release events were
    logged, or the queue process was killed before it could log one)."""
    os.makedirs(QUEUE, exist_ok=True)
    with Lock():
        held = {n: r.get("pid") for n, r in tickets() if r.get("state") == "running"}
    me = host()
    jobs, cancels = {}, []
    try:
        with open(LOG) as f:
            rows = [json.loads(line) for line in f if line.strip()]
    except OSError:
        rows = []
    for r in rows:
        try:
            at = parse_utc(r["ts"])
        except (KeyError, ValueError):
            continue
        key = (r.get("host"), r.get("ticket"))
        if r.get("event") == "admit":
            jobs[key] = {"admit": r, "admitted": at, "release": None, "released": None}
        elif r.get("event") == "release" and key in jobs:
            jobs[key].update(release=r, released=at)
        elif r.get("event") == "cancel" and t_from <= at <= t_to:
            cancels.append(r)
    out = []
    for j in sorted(jobs.values(), key=lambda j: j["admitted"]):
        if j["admitted"] > t_to or (j["released"] and j["released"] < t_from):
            continue
        a, rel = j["admit"], j["release"] or {}
        n = a.get("ticket")
        # Running: this host still holds the ticket, under the admit's pid (older admits log none; the number decides).
        live = a.get("host") == me and n in held and a.get("pid", held[n]) == held[n]
        state = "released" if j["release"] else "running" if live else UNKNOWN
        out.append({"event": "job", "host": a.get("host"), "ticket": a.get("ticket"), "agent": a.get("agent"),
                    "cmd": shlex.join(a.get("command") or [])[:120], "slot": a.get("slot"), "clamp": a.get("clamp"),
                    "lane": a.get("lane"), "hold": a.get("hold"), "state": state, "admitted": a["ts"],
                    "released": rel.get("ts"), "wait_s": a.get("wait_s"), "run_s": rel.get("run_s"),
                    "exit": rel.get("exit")})
    for c in cancels:
        out.append({"event": "cancel", "host": c.get("host"), "ticket": c.get("ticket"), "agent": c.get("agent"),
                    "cmd": shlex.join(c.get("command") or [])[:120], "at": c["ts"], "wait_s": c.get("wait_s")})
    return out


def default_gate():
    """machine-ok next to this file as invoked (for the installed link, the pinned ~/.local/bin/machine-ok), else on PATH."""
    here = os.path.join(os.path.dirname(os.path.abspath(sys.argv[0])), "machine-ok")
    return here if os.access(here, os.X_OK) else shutil.which("machine-ok")


def main(argv):
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if argv == ["status"]:
        print(listing())
        return 0
    if argv[:1] == ["log"]:
        opts = dict(zip(argv[1::2], argv[2::2]))
        try:
            if len(argv) != 5 or set(opts) != {"--from", "--to"}:
                raise ValueError("log needs --from and --to")
            rows = excerpt(parse_utc(opts["--from"]), parse_utc(opts["--to"]))
        except ValueError as e:
            print(f"machine-ok-queue: {e}\n{USAGE}", file=sys.stderr)
            return 2
        for row in rows:
            print(json.dumps(row))
        return 0
    if argv[:1] != ["run"] or "--" not in argv:
        print(USAGE, file=sys.stderr)
        return 2
    cut = argv.index("--")
    opts, cmd = argv[1:cut], argv[cut + 1:]
    flags, gate_path, no_gate, agent, p_cores, cpu_gate = [], None, False, None, False, False
    i = 0
    while i < len(opts):
        a = opts[i]
        if a in ("--memory", "--gpu"):
            flags.append(a)
        elif a == "--cpu-gate":
            cpu_gate = True
        elif a == "--p-cores":
            p_cores = True
        elif a == "--no-gate":
            no_gate = True
        elif a in ("--gate", "--agent") and i + 1 < len(opts):
            i += 1
            if a == "--gate":
                gate_path = opts[i]
            else:
                agent = opts[i]
        else:
            print(USAGE, file=sys.stderr)
            return 2
        i += 1
    if not cmd or (gate_path and no_gate) or (cpu_gate and "--memory" in flags):
        print(USAGE, file=sys.stderr)
        return 2
    # The gate's flags: --memory unless --cpu-gate asks for the full gate; --gpu passes through.
    flags = ([] if cpu_gate else ["--memory"]) + (["--gpu"] if "--gpu" in flags else [])
    if not no_gate:
        gate_path = gate_path or default_gate()
        if not gate_path and platform.system() == "Linux":
            say("no machine-ok on this Linux host: admission is by slots alone (gate flags ignored)")
            no_gate = True
        elif not gate_path:
            print("machine-ok-queue: no machine-ok next to this file or on PATH to gate with "
                  "(--no-gate admits on a free slot alone)", file=sys.stderr)
            return 2
    clamp = (UNCLAMPED if p_cores else CLAMP) if platform.system() == "Darwin" else None
    return run(cmd, None if no_gate else [gate_path, *flags], flags, agent=agent, clamp=clamp)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
