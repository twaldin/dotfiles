{
  "modelRoles": {
    "default": "anthropic/claude-opus-5-5:xhigh",
    "task": "anthropic/claude-sonnet-5-5:xhigh",
    "opus": "anthropic/claude-opus-5-5:xhigh",
    "grok": "xai-oauth/grok-4.7:xhigh",
    "slow": "openai-codex/gpt-6.1-sol:xhigh",
    "tiny": "zai/glm-5.3-flash:high",
    "luna": "openai-codex/gpt-6-luna:xhigh",
    "advisor": "xai-oauth/grok-4.7:xhigh",
    "smol": "zai/glm-5.3-flash:high",
    "review": "openai-codex/gpt-6-astra:xhigh",
    "sol": "openai-codex/gpt-6.1-sol:xhigh",
    "fable": "anthropic/claude-fable-5-1:xhigh"
  },
  "cycleOrder": [
    "default",
    "fable",
    "slow"
  ],
  "retry": {
    "fallbackChains": {
      "default": ["openai-codex/gpt-6.1-sol"],
      "task": ["openai-codex/gpt-6.1-sol"],
      "sol": ["anthropic/claude-sonnet-5-5"],
      "review": ["xai-oauth/grok-4.7"],
      "tiny": ["openai-codex/gpt-6-luna"],
      "opencode-go/*": ["zai/glm-5.3-flash"]
    }
  },
  "task": {
    "agentModelOverrides": {
      "reviewer": "@review",
      "security-reviewer": "@review",
      "scout": "@sol"
    },
    "showResolvedModelBadge": true,
    "isolation": {
      "enabled": true
    }
  },
  "compaction": {
    "thresholdPercent": -1,
    "thresholdTokens": 500000
  },
  "statusLine": {
    "preset": "full"
  },
  "modelRoleStorage": "global",
  "defaultThinkingLevel": "auto",
  "theme": {
    "dark": "dark-tokyo-night",
    "light": "light"
  },
  "symbolPreset": "nerd",
  "disabledProviders": [
    "claude",
    "claude-md",
    "claude-plugins",
    "codex",
    "gemini",
    "opencode",
    "cursor",
    "windsurf",
    "cline",
    "github",
    "vscode",
    "agent-plugins",
    "omp-plugins",
    "mcp-json",
    "omp-managed",
    "agents"
  ],
  "skills": {
    "enabled": true,
    "enableCodexUser": false,
    "enableClaudeUser": false,
    "enableClaudeProject": false,
    "enablePiUser": false,
    "enablePiProject": true,
    "enableAgentsUser": false,
    "enableAgentsProject": false
  },
  "commands": {
    "enableClaudeUser": false,
    "enableClaudeProject": false,
    "enableOpencodeUser": false,
    "enableOpencodeProject": false
  },
  "mcp": {
    "enableProjectConfig": false
  },
  "autolearn": {
    "enabled": false,
    "autoContinue": false
  },
  "advisor": {
    "enabled": false
  },
  "ask": {
    "timeout": 0
  }
}
