#!/bin/sh

# yabai runs in basic mode with System Integrity Protection fully enabled.
# Do not add --load-sa or scripting-addition-only settings here.
YABAI=/opt/homebrew/bin/yabai

"$YABAI" -m config \
  external_bar all:32:0 \
  mouse_follows_focus off \
  focus_follows_mouse off \
  display_arrangement_order default \
  window_origin_display default \
  window_placement second_child \
  window_insertion_point last \
  window_zoom_persist on \
  skip_window_focus_animation on \
  window_animation_duration 0.0 \
  split_ratio 0.55 \
  split_type auto \
  auto_balance off \
  top_padding 10 \
  bottom_padding 10 \
  left_padding 10 \
  right_padding 10 \
  window_gap 8 \
  layout bsp \
  mouse_modifier fn \
  mouse_action1 move \
  mouse_action2 resize \
  mouse_drop_action swap

# Launchers and settings overlays are not useful BSP tiles.
"$YABAI" -m rule --add label=raycast app='^Raycast$' manage=off
"$YABAI" -m rule --add label=system-settings app='^System Settings$' manage=off
