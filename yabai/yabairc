#!/bin/sh

# yabai runs in basic mode with System Integrity Protection fully enabled.
# Do not add --load-sa or scripting-addition-only settings here.
YABAI=/Users/twaldin/Applications/Yabai.app/Contents/MacOS/yabai

"$YABAI" -m config \
  external_bar all:36:0 \
  mouse_follows_focus off \
  focus_follows_mouse off \
  display_arrangement_order default \
  window_origin_display default \
  window_placement second_child \
  window_insertion_point last \
  window_zoom_persist on \
  skip_window_focus_animation on \
  window_animation_duration 0.0 \
  split_ratio 0.55 \
  split_type auto \
  auto_balance off \
  top_padding 10 \
  bottom_padding 10 \
  left_padding 10 \
  right_padding 10 \
  window_gap 8 \
  layout bsp \
  mouse_modifier fn \
  mouse_action1 move \
  mouse_action2 resize \
  mouse_drop_action swap

# Launchers, dictation, and system overlays are not useful BSP tiles.
# Superwhisper also needs its Dock icon disabled (Superwhisper settings, or
# `defaults write com.superduper.superwhisper showApplicationInDock -bool false`):
# yabai's replacement focus picks its sticky recorder window, and a Dock-mode
# Superwhisper answers that activation by opening its main window. Its process
# name is `superwhisper` in 2.16 and `Superwhisper` in 2.18, and yabai app
# regexes are case-sensitive, so the rule matches both. Notification
# banners must never enter the BSP tree: clicking one can otherwise reinsert
# its transient node before macOS activates the destination application.
"$YABAI" -m rule --add label=raycast app='^Raycast$' manage=off
"$YABAI" -m rule --add label=system-settings app='^System Settings$' manage=off
"$YABAI" -m rule --add label=superwhisper app='^[Ss]uperwhisper$' manage=off
"$YABAI" -m rule --add label=notification-center app='^(Notification Center|NotificationCenter|UserNotificationCenter)$' manage=off
"$YABAI" -m rule --add label=notification-overlay subrole='^AXNotificationCenter$' manage=off
# Screen Sharing keeps a title-less, role-less window that yabai would tile full-size.
"$YABAI" -m rule --add label=screen-sharing app='^Screen Sharing$' manage=off
# Each native easl tab is its own window: tiled, every tab switch re-tiles the shown tab and
# the board visibly jumps. Unmanaged, AppKit keeps the tab group at one frame, and Tim can
# stack apps over it. No grid rule: resizing each new tab window would resize the group.
"$YABAI" -m rule --add label=easl app='^easl$' manage=off

# Spaces 6-8 on the built-in display belong to agents' GUI test windows (Tim keeps to 1-4):
# 6 roblox, 7 canvas, 8 Minecraft labs. Float layout so a window moved there keeps its own
# size (game clients lock theirs) and never re-tiles anything. Windows on a Space nobody is
# viewing keep rendering and stay capturable (measured 2026-09-30: a Metal render loop held
# 120 fps and gave fresh `screencapture -l` frames on hidden Space 7).
for space in 6 7 8; do "$YABAI" -m config --space "$space" layout float; done
